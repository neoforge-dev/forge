        return JSONResponse(content=result.to_dict())

    @app.get("/api/metrics")
    async def api_metrics():
        """Get basic server metrics.

        Returns:
            - uptime: Server uptime in seconds
            - request_count: Total number of requests processed
            - active_agents: Number of currently active agents
            - timestamp: Current server timestamp
        """
        try:
            # Calculate uptime
            uptime_seconds = int(time.time() - _server_start_time)

            # Get active agents count
            active_agents_count = 0
            try:
                # Try to get agents from state store
                from forge_harness.state_store import StateStore

                state_store = StateStore()
                if state_store and state_store.is_connected():
                    agents = state_store.get_active_agents()
                    active_agents_count = len(agents) if agents else 0
            except Exception as e:
                logger.warning(f"Failed to get active agents count: {e}")

            response = {
                "uptime_seconds": uptime_seconds,
                "request_count": _request_counter["total"],
                "active_agents": active_agents_count,
                "timestamp": datetime.now(UTC).isoformat(),
            }

            return JSONResponse(content=api_response(response))

        except Exception as e:
            logger.error(f"Failed to get metrics: {e}")
            return JSONResponse(
                status_code=500,
                content=api_response(
                    error_code="METRICS_ERROR",
                    error_message=f"Failed to retrieve metrics: {str(e)}",
                ),
            )

    @app.get("/api/version")
    async def api_version():
        """Get server version information.

        Returns version from pyproject.toml and FastAPI app version.
        """
        try:
            # Get version from pyproject.toml
            version = "1.0.0"  # Default
            try:
                import pathlib
                import tomllib

                pyproject_path = pathlib.Path(__file__).parent.parent / "pyproject.toml"
                if pyproject_path.exists():
                    with open(pyproject_path, "rb") as f:
                        pyproject = tomllib.load(f)
                        version = pyproject.get("project", {}).get("version", "1.0.0")
            except Exception as e:
                logger.warning(f"Failed to read version from pyproject.toml: {e}")

            response = {
                "version": version,
                "service": "forge-harness-webhooks",
                "api_version": "1.0.0",
            }

            return JSONResponse(content=api_response(response))

        except Exception as e:
            logger.error(f"Failed to get version: {e}")
            return JSONResponse(
                status_code=500,
                content=api_response(
                    error_code="VERSION_ERROR",
                    error_message=f"Failed to retrieve version: {str(e)}",
                ),
            )

    # =========================================================================
    # SSE Events Endpoint
    # =========================================================================

    @app.get("/api/events")
    async def sse_events(
        request: Request,
        token: str = Query(default=""),
    ):
        """Server-Sent Events endpoint for real-time updates.

        Streams events from the EventBus to connected clients with automatic
        heartbeat every 30 seconds to keep connections alive through proxies.

        Query Parameters:
            token: Bearer token for authentication

        Events:
            - agent.progress: Agent progress updates
            - agent.status: Agent status changes
            - approval.created: New approval requests
            - approval.updated: Approval status changes
            - pattern.outcome: Pattern execution results
            - system.notification: System notifications
            - heartbeat: Keep-alive heartbeat (every 30s)

        Returns:
            StreamingResponse with text/event-stream content type
        """
        # Verify authentication
        authorization = f"Bearer {token}" if token else None
        client_host = request.client.host if request.client else None
        host_header = request.headers.get("host", "")

        if _auth_config.allow_localhost and _is_localhost_request(client_host, host_header):
            pass  # Localhost bypass
        else:
            auth_result = verify_bearer_token(authorization, _auth_config, client_host)
            if auth_result == AuthResult.MISSING_TOKEN:
                raise HTTPException(
                    status_code=401,
                    detail="Missing authentication token. Provide token as query parameter: ?token=YOUR_TOKEN",
                )
            elif auth_result == AuthResult.INVALID_TOKEN:
                raise HTTPException(
                    status_code=401,
                    detail="Invalid authentication token",
                )

        logger.info(f"SSE connection established from {client_host}")

        async def event_generator():
            """Generate SSE events with heartbeat support."""
            # Get event bus and subscribe
            event_bus = get_event_bus()
            queue = event_bus.subscribe()
            last_heartbeat = time.time()
            heartbeat_interval = SSE_HEARTBEAT_INTERVAL

            try:
                while True:
                    # Check if heartbeat is due
                    now = time.time()
                    if now - last_heartbeat >= heartbeat_interval:
                        # Send heartbeat event
                        heartbeat_event = SSEEvent(
                            id=f"heartbeat_{int(now)}",
                            event="heartbeat",
                            data={"timestamp": datetime.now(UTC).isoformat()},
                            source="webhook-server",
                        )
                        yield heartbeat_event.to_sse_format()
                        last_heartbeat = now

                    # Wait for real events from the event bus with timeout
                    try:
                        event = await asyncio.wait_for(queue.get(), timeout=1.0)

                        # None signals connection close
                        if event is None:
                            break

                        # Send event to client
                        yield event.to_sse_format()

                    except TimeoutError:
                        # No event received, continue to check heartbeat
                        continue

            except asyncio.CancelledError:
                logger.info(f"SSE connection cancelled for {client_host}")
                raise
            finally:
                # Clean up subscription
                event_bus.unsubscribe(queue)
                logger.info(f"SSE connection closed for {client_host}")

        return StreamingResponse(
            event_generator(),
            media_type="text/event-stream",
            headers={
                "Cache-Control": "no-cache",
                "X-Accel-Buffering": "no",  # Disable nginx buffering
            },
        )

    # =========================================================================
    # State Synchronization Endpoints
    # =========================================================================

    @app.get("/api/state/snapshot")
    async def get_state_snapshot(_: None = Depends(verify_auth)):
        """Get unified state snapshot from all checkpoint sources.

        Returns a combined view of:
        - Pending approvals
        - Active pipelines
        - Ralph loop status
        - Active sessions

        This endpoint uses the StateSynchronizer for consistent state.
        """
        synchronizer = get_state_synchronizer()
        if synchronizer is None:
            return JSONResponse(
                content=api_response(
                    error_code="SYNCHRONIZER_NOT_AVAILABLE",
                    error_message="State synchronizer is not initialized",
                ),
                status_code=503,
            )

        try:
            # Get current state snapshot
            snapshot = synchronizer.get_state_snapshot()
            return JSONResponse(
                content=api_response(
                    {
                        "approvals": [a.__dict__ for a in snapshot.approvals],
                        "pipelines": [p.__dict__ for p in snapshot.pipelines],
                        "ralph": snapshot.ralph.__dict__ if snapshot.ralph else None,
                        "sessions": [s.__dict__ for s in snapshot.sessions],
                        "sync_stats": synchronizer.get_stats(),
                        "last_sync": snapshot.timestamp.isoformat() if snapshot.timestamp else None,
                    }
                )
            )
        except Exception as e:
            logger.error(f"Error getting state snapshot: {e}")
            return JSONResponse(
                content=api_response(
                    error_code="SNAPSHOT_ERROR",
                    error_message=str(e),
                ),
                status_code=500,
            )

    @app.post("/api/state/sync")
    async def trigger_state_sync(_: None = Depends(verify_auth)):
        """Trigger an immediate state synchronization.

        Useful for forcing a sync when files have been modified externally.
        """
        synchronizer = get_state_synchronizer()
        if synchronizer is None:
            return JSONResponse(
                content=api_response(
                    error_code="SYNCHRONIZER_NOT_AVAILABLE",
                    error_message="State synchronizer is not initialized",
                ),
                status_code=503,
            )

        try:
            snapshot = await synchronizer.sync_all()
            stats = synchronizer.get_stats()
            return JSONResponse(
                content=api_response(
                    {
                        "status": "synced",
                        "approvals_count": len(snapshot.approvals),
                        "pipelines_count": len(snapshot.pipelines),
                        "sessions_count": len(snapshot.sessions),
                        "sync_stats": stats,
                    }
                )
            )
        except Exception as e:
            logger.error(f"Error triggering state sync: {e}")
            return JSONResponse(
                content=api_response(
                    error_code="SYNC_ERROR",
                    error_message=str(e),
                ),
                status_code=500,
            )

    @app.get("/api/state/stats")
    async def get_sync_stats(_: None = Depends(verify_auth)):
        """Get synchronizer statistics.

        Returns metrics about sync performance, errors, and file tracking.
        """
        synchronizer = get_state_synchronizer()
        if synchronizer is None:
            return JSONResponse(
                content=api_response(
                    {
                        "status": "unavailable",
                        "message": "State synchronizer is not initialized",
                    }
                )
            )

        stats = synchronizer.get_stats()
        return JSONResponse(content=api_response(stats))

    # =========================================================================
    # Webhook Endpoints
    # =========================================================================

    @app.post("/api/webhooks/slack")
    async def slack_webhook(
        request: Request,
        x_slack_signature: str | None = Header(None),
        x_slack_request_timestamp: str | None = Header(None),
        _: None = Depends(check_rate_limit),
    ):
        """Handle Slack interactive message webhooks."""
        body = await request.body()

        # Verify signature - required when secret is configured
        if _handler.slack_signing_secret:
            # Require signature headers when secret is configured
            if not x_slack_signature or not x_slack_request_timestamp:
                raise HTTPException(
                    status_code=401,
                    detail="Missing signature headers (X-Slack-Signature, X-Slack-Request-Timestamp)",
                )
            if not _handler.verify_slack_signature(
                body, x_slack_signature, x_slack_request_timestamp
            ):
                raise HTTPException(status_code=401, detail="Invalid signature")

        # Parse payload (Slack sends as form data or JSON)
        try:
            import json

            payload = json.loads(body)
        except json.JSONDecodeError:
            from urllib.parse import parse_qs

            form_data = parse_qs(body.decode("utf-8"))
            if "payload" in form_data:
                import json

                payload = json.loads(form_data["payload"][0])
            else:
                raise HTTPException(status_code=400, detail="Invalid payload")

        response = await _handler.handle_slack(
            payload, x_slack_signature, x_slack_request_timestamp
        )
        return JSONResponse(
            content={
                "status": response.status,
                "notification_id": response.notification_id,
                "message": response.message,
            }
        )

    @app.post("/api/webhooks/github")
    async def github_webhook(
        request: Request,
        x_hub_signature_256: str | None = Header(None),
        x_github_event: str = Header(default="ping"),
        _: None = Depends(check_rate_limit),
    ):
        """Handle GitHub webhook events."""
        body = await request.body()

        # Verify signature - required when secret is configured
        if _handler.github_webhook_secret:
            # Require signature header when secret is configured
            if not x_hub_signature_256:
                raise HTTPException(
                    status_code=401, detail="Missing signature header (X-Hub-Signature-256)"
                )
            if not _handler.verify_github_signature(body, x_hub_signature_256):
                raise HTTPException(status_code=401, detail="Invalid signature")

        # Handle ping events
        if x_github_event == "ping":
            return JSONResponse(content={"status": "pong"})

        # Parse payload
        import json

        try:
            payload = json.loads(body)
        except json.JSONDecodeError:
            raise HTTPException(status_code=400, detail="Invalid JSON payload")

        response = await _handler.handle_github(payload, x_hub_signature_256, x_github_event)
        return JSONResponse(
            content={
                "status": response.status,
                "notification_id": response.notification_id,
                "message": response.message,
            }
        )

    # =========================================================================
    # Telegram Bot Webhook Endpoints
    # =========================================================================

    # Initialize Telegram bot handler (lazy loaded)
    _telegram_handler: Any | None = None

    def get_telegram_handler() -> Any:
        """Get or create Telegram bot handler."""
        nonlocal _telegram_handler
        if _telegram_handler is None:
            from .telegram_bot import TelegramBotHandler

            _telegram_handler = TelegramBotHandler.from_env()
        return _telegram_handler

    @app.post("/webhook/telegram")
    async def telegram_webhook(
        request: Request,
        x_telegram_bot_api_secret_token: str | None = Header(None),
    ):
        """Handle Telegram Bot API webhook updates.

        Receives updates from Telegram when users send messages or interact
        with inline keyboards. Routes commands to appropriate handlers.

        Headers:
            X-Telegram-Bot-Api-Secret-Token: Webhook secret for verification

        Returns:
            {"ok": True} on success
        """
        handler = get_telegram_handler()

        # Verify webhook if secret is configured
        if not handler.verify_webhook(
            {"X-Telegram-Bot-Api-Secret-Token": x_telegram_bot_api_secret_token or ""}
        ):
            raise HTTPException(status_code=401, detail="Invalid webhook secret")

        # Parse update
        try:
            update = await request.json()
        except Exception:
            raise HTTPException(status_code=400, detail="Invalid JSON payload")

        try:
            result = await handler.handle_update(update)
            return JSONResponse(content={"ok": True, **result})
        except Exception as e:
            logger.error(f"Error handling Telegram update: {e}")
            # Still return ok to Telegram to prevent retries
            return JSONResponse(content={"ok": False, "error": str(e)})

    @app.get("/api/telegram/status")
    async def telegram_status(
        _: None = Depends(verify_auth),
    ):
        """Get Telegram bot status and configuration.

        Returns:
            Bot configuration info without sensitive data
        """
        handler = get_telegram_handler()
        info = handler.get_bot_info()
        return JSONResponse(
            content=api_response(
                {
                    "configured": info["configured"],
                    "has_token": info["has_token"],
                    "allowed_users_count": info["allowed_users_count"],
                    "has_webhook_secret": info["has_webhook_secret"],
                    "authorized_chats": info["authorized_chats"],
                }
            )
        )

    @app.post("/api/telegram/broadcast")
    async def telegram_broadcast(
        request: Request,
        _: None = Depends(verify_auth),
    ):
        """Broadcast a message to all authorized Telegram users.

        Body:
            {
                "message": "Text to broadcast",
                "tier": "phone" (optional, default: phone)
            }

        Returns:
            Results for each user
        """
        handler = get_telegram_handler()

        if not handler.is_configured():
            return JSONResponse(
                status_code=503,
                content=api_response(
                    error_code="NOT_CONFIGURED",
                    error_message="Telegram bot not configured",
                ),
            )

        try:
            data = await request.json()
            message = data.get("message", "")
            tier = data.get("tier", "phone")

            if not message:
                return JSONResponse(
                    status_code=400,
                    content=api_response(
                        error_code="MISSING_MESSAGE",
                        error_message="message field is required",
                    ),
                )

            results = await handler.broadcast(message, tier=tier)
            success_count = sum(1 for r in results if r.get("success"))

            return JSONResponse(
                content=api_response(
                    {
                        "sent": success_count,
                        "total": len(results),
                        "results": results,
                    }
                )
            )
        except Exception as e:
            logger.error(f"Error broadcasting Telegram message: {e}")
            return JSONResponse(
                status_code=500,
                content=api_response(
                    error_code="BROADCAST_ERROR",
                    error_message=str(e),
                ),
            )

