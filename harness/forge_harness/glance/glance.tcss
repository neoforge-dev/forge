/* FORGE Glance Dashboard — Catppuccin Mocha Theme */

Screen {
    background: #1e1e2e;  /* Base */
    color: #cdd6f4;       /* Text */
}

/* ---- Grid layouts by breakpoint class ---- */

#card-grid {
    layout: grid;
    grid-size: 3 2;
    grid-gutter: 1;
    padding: 0 1;
    height: 1fr;
    overflow-y: auto;
}

/* Responsive overrides via app-level classes */
Screen.ultrawide #card-grid {
    grid-size: 4 2;
}

Screen.wide #card-grid {
    grid-size: 4 2;
}

Screen.medium #card-grid {
    grid-size: 2 4;
}

Screen.compact #card-grid {
    grid-size: 1 3;
}

Screen.micro #card-grid {
    grid-size: 1 1;
}

/* ---- Header bar ---- */

#header-bar {
    dock: top;
    height: 1;
    background: #313244;  /* Surface0 */
    color: #cdd6f4;
    text-style: bold;
    padding: 0 1;
}

/* ---- Status bar ---- */

#status-bar {
    height: 1;
    background: #313244;
    color: #a6adc8;       /* Subtext0 */
    padding: 0 1;
    dock: bottom;
}

/* ---- Card styling ---- */

GlanceCard {
    border: solid #45475a;  /* Surface1 */
    background: #1e1e2e;
    padding: 0 1;
    height: auto;
    min-height: 3;
    max-height: 18;
}

GlanceCard:focus-within {
    border: solid #89b4fa;  /* Blue accent */
}

.card-title {
    text-style: bold;
    color: #cdd6f4;
}

.card-body {
    color: #bac2de;         /* Subtext1 */
    height: auto;
}

/* ---- Semantic status colors ---- */

.status-ok    { color: #a6e3a1; }  /* Green */
.status-warn  { color: #f9e2af; }  /* Yellow */
.status-error { color: #f38ba8; }  /* Red */
.status-idle  { color: #6c7086; }  /* Overlay0 */

/* ---- Help overlay ---- */

#help-overlay {
    align: center middle;
    background: #313244 80%;
    padding: 2 4;
    border: double #89b4fa;
    max-width: 60;
    max-height: 20;
    display: none;
}

Screen.show-help #help-overlay {
    display: block;
}
