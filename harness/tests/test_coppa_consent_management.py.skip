"""Tests for COPPA parental consent management functionality."""

import uuid
from datetime import UTC, datetime, timedelta

import pytest

from forge_shared.compliance.coppa import (
    COPPAComplianceService,
    ConsentStatus,
    ParentalConsent,
)


class TestParentalConsentModel:
    """Test ParentalConsent model validation."""

    def test_valid_consent_creation(self):
        """Test creating a valid parental consent record."""
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent_456",
            child_id="child_789",
            consent_method="email",
            consent_proof="email_verification_code",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
        )

        assert consent.id == "consent_123"
        assert consent.parent_account_id == "parent_456"
        assert consent.child_id == "child_789"
        assert consent.consent_method == "email"
        assert consent.consent_proof == "email_verification_code"
        assert consent.terms_version == "1.0"
        assert consent.status == ConsentStatus.VERIFIED

    def test_consent_default_status(self):
        """Test that consent defaults to VERIFIED status."""
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent_456",
            child_id="child_789",
            consent_method="credit_card",
            consent_proof="tx_abc123",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
        )

        assert consent.status == ConsentStatus.VERIFIED

    def test_consent_with_optional_fields(self):
        """Test consent with all optional fields."""
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent_456",
            child_id="child_789",
            consent_method="phone",
            consent_proof="call_recording_id",
            terms_version="2.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
            ip_address="192.168.1.1",
            user_agent="Mozilla/5.0",
        )

        assert consent.ip_address == "192.168.1.1"
        assert consent.user_agent == "Mozilla/5.0"

    def test_consent_timestamp_auto_set(self):
        """Test that consent_timestamp is auto-set."""
        before = datetime.now(UTC)
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent_456",
            child_id="child_789",
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
        )
        after = datetime.now(UTC)

        assert before <= consent.consent_timestamp <= after


class TestConsentManagementService:
    """Test COPPA compliance service consent management."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()
        self.parent_id = f"parent_{uuid.uuid4().hex[:8]}"
        self.child_id = f"child_{uuid.uuid4().hex[:8]}"

    async def test_record_consent(self):
        """Test recording a parental consent."""
        consent = ParentalConsent(
            id=f"consent_{uuid.uuid4().hex[:8]}",
            parent_account_id=self.parent_id,
            child_id=self.child_id,
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
        )

        await self.service.record_consent(consent)

        stored = await self.service.get_consent(consent.id)
        assert stored is not None
        assert stored.id == consent.id
        assert stored.consent_method == "email"

    async def test_get_nonexistent_consent(self):
        """Test getting a consent that doesn't exist."""
        result = await self.service.get_consent("nonexistent_id")
        assert result is None

    async def test_get_child_consents(self):
        """Test getting all consents for a child."""
        # Create multiple consents for the same child
        for method in ["email", "digital_signature"]:
            consent = ParentalConsent(
                id=f"consent_{uuid.uuid4().hex[:8]}",
                parent_account_id=self.parent_id,
                child_id=self.child_id,
                consent_method=method,
                terms_version="1.0",
                expires_at=datetime.now(UTC) + timedelta(days=365),
            )
            await self.service.record_consent(consent)

        consents = await self.service.get_child_consents(self.child_id)
        assert len(consents) == 2

    async def test_withdraw_consent(self):
        """Test withdrawing parental consent."""
        consent = ParentalConsent(
            id=f"consent_{uuid.uuid4().hex[:8]}",
            parent_account_id=self.parent_id,
            child_id=self.child_id,
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
        )
        await self.service.record_consent(consent)

        result = await self.service.withdraw_consent(consent.id)
        assert result is True

        updated = await self.service.get_consent(consent.id)
        assert updated.status == ConsentStatus.WITHDRAWN

    async def test_withdraw_nonexistent_consent(self):
        """Test withdrawing a consent that doesn't exist."""
        result = await self.service.withdraw_consent("nonexistent_id")
        assert result is False

    async def test_withdraw_updates_child_profile(self):
        """Test that withdrawing consent updates child profile status."""
        # Create child profile
        profile = await self.service.create_child_profile(parent_account_id=self.parent_id, age=8)
        self.child_id = profile.child_id

        # Create and record consent
        consent = ParentalConsent(
            id=f"consent_{uuid.uuid4().hex[:8]}",
            parent_account_id=self.parent_id,
            child_id=self.child_id,
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
        )
        await self.service.record_consent(consent)

        # Verify profile is updated
        updated_profile = await self.service.get_child_profile(self.child_id)
        assert updated_profile.consent_status == ConsentStatus.VERIFIED

        # Withdraw consent
        await self.service.withdraw_consent(consent.id)

        # Verify profile is updated
        withdrawn_profile = await self.service.get_child_profile(self.child_id)
        assert withdrawn_profile.consent_status == ConsentStatus.WITHDRAWN


class TestConsentValidation:
    """Test consent validation functionality."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_validate_consent_valid(self):
        """Test validating a valid consent."""
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent_456",
            child_id="child_789",
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
        )

        result = self.service.validate_parental_consent(consent, "1.0")
        assert result is True

    def test_validate_consent_wrong_terms_version(self):
        """Test validating consent with outdated terms."""
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent_456",
            child_id="child_789",
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
        )

        result = self.service.validate_parental_consent(consent, "2.0")
        assert result is False

    def test_validate_consent_expired(self):
        """Test validating an expired consent."""
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent_456",
            child_id="child_789",
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) - timedelta(days=1),  # Expired
        )

        result = self.service.validate_parental_consent(consent, "1.0")
        assert result is False

    def test_validate_consent_pending_status(self):
        """Test validating a pending consent."""
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent_456",
            child_id="child_789",
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
            status=ConsentStatus.PENDING,
        )

        result = self.service.validate_parental_consent(consent, "1.0")
        assert result is False


class TestConsentExpiry:
    """Test consent expiration functionality."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_calculate_consent_expiry(self):
        """Test calculating consent expiration date."""
        consent_timestamp = datetime.now(UTC)
        expiry = self.service.calculate_consent_expiry(consent_timestamp)

        expected = consent_timestamp + timedelta(days=365)
        assert expiry.date() == expected.date()
        assert expiry > consent_timestamp

    def test_consent_expiry_is_one_year(self):
        """Test that consent expires in exactly one year."""
        consent_timestamp = datetime.now(UTC).replace(month=6, day=15)
        expiry = self.service.calculate_consent_expiry(consent_timestamp)

        assert expiry.year == consent_timestamp.year + 1
        assert expiry.month == consent_timestamp.month
        assert expiry.day == consent_timestamp.day


class TestConsentMethodRequirements:
    """Test consent method age requirements."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_consent_method_ages(self):
        """Test that consent method age requirements are defined."""
        ages = self.service.CONSENT_METHOD_AGES

        assert "email" in ages
        assert "credit_card" in ages
        assert "mail" in ages
        assert "phone" in ages
        assert "digital_signature" in ages
        assert "parent_email" in ages

    def test_parent_email_for_any_age(self):
        """Test that parent email consent can be used for any age."""
        ages = self.service.CONSENT_METHOD_AGES
        assert ages["parent_email"] == 0

    def test_credit_card_requires_older_age(self):
        """Test that credit card verification requires older age."""
        ages = self.service.CONSENT_METHOD_AGES
        assert ages["credit_card"] > ages["email"]


class TestConsentWorkflow:
    """Test complete consent workflows."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    async def test_full_consent_workflow(self):
        """Test complete consent workflow from creation to withdrawal."""
        parent_id = f"parent_{uuid.uuid4().hex[:8]}"
        child_id = f"child_{uuid.uuid4().hex[:8]}"

        # 1. Create child profile
        profile = await self.service.create_child_profile(parent_account_id=parent_id, age=7)
        assert profile.consent_status == ConsentStatus.PENDING

        # 2. Record parental consent
        consent = ParentalConsent(
            id=f"consent_{uuid.uuid4().hex[:8]}",
            parent_account_id=parent_id,
            child_id=child_id,
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) + timedelta(days=365),
        )
        await self.service.record_consent(consent)

        # 3. Verify consent is stored
        stored = await self.service.get_consent(consent.id)
        assert stored is not None

        # 4. Validate consent
        is_valid = self.service.validate_parental_consent(consent, "1.0")
        assert is_valid is True

        # 5. Withdraw consent
        await self.service.withdraw_consent(consent.id)

        # 6. Verify consent is withdrawn
        withdrawn = await self.service.get_consent(consent.id)
        assert withdrawn.status == ConsentStatus.WITHDRAWN

    async def test_multiple_children_consent_tracking(self):
        """Test tracking consents for multiple children."""
        parent_id = f"parent_{uuid.uuid4().hex[:8]}"

        # Create two children
        child1_id = (await self.service.create_child_profile(parent_id, 5)).child_id
        child2_id = (await self.service.create_child_profile(parent_id, 10)).child_id

        # Create consents for both
        for child_id in [child1_id, child2_id]:
            consent = ParentalConsent(
                id=f"consent_{uuid.uuid4().hex[:8]}",
                parent_account_id=parent_id,
                child_id=child_id,
                consent_method="email",
                terms_version="1.0",
                expires_at=datetime.now(UTC) + timedelta(days=365),
            )
            await self.service.record_consent(consent)

        # Get children by parent
        children = await self.service.get_children_by_parent(parent_id)
        assert len(children) == 2


if __name__ == "__main__":
    pytest.main([__file__, "-v"])
