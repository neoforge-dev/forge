"""Integration tests for COPPA compliance service."""

import uuid
from datetime import UTC, datetime, timedelta

import pytest

from forge_shared.compliance.coppa import (
    ChildProfile,
    COPPAComplianceService,
    ConsentStatus,
    ParentalConsent,
)


class TestChildProfileManagement:
    """Test child profile CRUD operations."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()
        self.parent_id = f"parent_{uuid.uuid4().hex[:8]}"

    async def test_create_child_profile(self):
        """Test creating a child profile."""
        profile = await self.service.create_child_profile(parent_account_id=self.parent_id, age=8)

        assert profile.child_id is not None
        assert profile.parent_account_id == self.parent_id
        assert profile.age == 8
        assert profile.consent_status == ConsentStatus.PENDING

    async def test_get_child_profile(self):
        """Test retrieving a child profile."""
        created = await self.service.create_child_profile(parent_account_id=self.parent_id, age=10)
        retrieved = await self.service.get_child_profile(created.child_id)

        assert retrieved is not None
        assert retrieved.child_id == created.child_id
        assert retrieved.age == 10

    async def test_get_nonexistent_profile(self):
        """Test retrieving a profile that doesn't exist."""
        result = await self.service.get_child_profile("nonexistent_id")
        assert result is None

    async def test_get_children_by_parent(self):
        """Test getting all children for a parent."""
        # Create multiple children
        for age in [5, 8, 12]:
            await self.service.create_child_profile(parent_account_id=self.parent_id, age=age)

        children = await self.service.get_children_by_parent(self.parent_id)
        assert len(children) == 3

    async def test_child_profile_with_optional_fields(self):
        """Test creating profile with optional fields."""
        profile = await self.service.create_child_profile(
            parent_account_id=self.parent_id,
            age=7,
            grade_level=2,
            display_name="Star Learner",
        )

        assert profile.grade_level == 2
        assert profile.display_name == "Star Learner"


class TestAgeAppropriateConfiguration:
    """Test age-appropriate configuration generation."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_preschool_ui_config(self):
        """Test UI configuration for preschool ages (3-5)."""
        config = self.service.get_age_appropriate_config(4, "ui")

        assert config["touch_target_min_size"] == 75
        assert config["text_min_size"] == 24
        assert config["complexity"] == "minimal"
        assert config["animation"] == "frequent"

    def test_preschool_content_config(self):
        """Test content configuration for preschool ages."""
        config = self.service.get_age_appropriate_config(4, "content")

        assert config["vocabulary_level"] == "simple"
        assert config["sentence_length_max"] == 8
        assert config["illustration_style"] == "cartoon"

    def test_preschool_feedback_config(self):
        """Test feedback configuration for preschool ages."""
        config = self.service.get_age_appropriate_config(4, "feedback")

        assert config["encouragement_frequency"] == "very_high"
        assert config["celebration"] == "elaborate"

    def test_early_elementary_ui_config(self):
        """Test UI configuration for early elementary (6-8)."""
        config = self.service.get_age_appropriate_config(7, "ui")

        assert config["touch_target_min_size"] == 56
        assert config["text_min_size"] == 18
        assert config["complexity"] == "low"

    def test_late_elementary_ui_config(self):
        """Test UI configuration for late elementary (9-10)."""
        config = self.service.get_age_appropriate_config(10, "ui")

        assert config["touch_target_min_size"] == 48
        assert config["text_min_size"] == 16
        assert config["complexity"] == "medium"

    def test_preteen_ui_config(self):
        """Test UI configuration for preteen (11-12)."""
        config = self.service.get_age_appropriate_config(11, "ui")

        assert config["touch_target_min_size"] == 44
        assert config["text_min_size"] == 14
        assert config["complexity"] == "medium_high"

    def test_teen_ui_config(self):
        """Test UI configuration for teen (13+)."""
        config = self.service.get_age_appropriate_config(15, "ui")

        assert config["touch_target_min_size"] == 44
        assert config["text_min_size"] == 14
        assert config["complexity"] == "standard"

    def test_unknown_config_type_returns_empty(self):
        """Test that unknown config type returns empty dict."""
        config = self.service.get_age_appropriate_config(10, "unknown")
        assert config == {}

    def test_content_config_vocabulary_by_age(self):
        """Test vocabulary level increases with age."""
        preschool = self.service.get_age_appropriate_config(4, "content")
        elementary = self.service.get_age_appropriate_config(8, "content")
        preteen = self.service.get_age_appropriate_config(11, "content")

        assert preschool["vocabulary_level"] == "simple"
        assert elementary["vocabulary_level"] == "simple"
        assert preteen["vocabulary_level"] == "advanced"


class TestFullCOPPAWorkflow:
    """Test complete COPPA compliance workflow."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    async def test_complete_child_onboarding_workflow(self):
        """Test complete workflow from age verification to consent."""
        parent_id = f"parent_{uuid.uuid4().hex[:8]}"

        # Step 1: Age verification
        is_verified, age_group = self.service.verify_age(age=8)
        assert is_verified is True
        assert age_group.value == "under_13"

        # Step 2: Verify consent is required
        assert self.service.is_consent_required(age=8) is True

        # Step 3: Create child profile
        profile = await self.service.create_child_profile(parent_account_id=parent_id, age=8)
        assert profile.consent_status == ConsentStatus.PENDING

        # Step 4: Get appropriate retention policy
        policy = self.service.get_retention_policy(8, ConsentStatus.PENDING)
        assert policy.value == "immediate"

        # Step 5: Record parental consent
        consent = ParentalConsent(
            id=f"consent_{uuid.uuid4().hex[:8]}",
            parent_account_id=parent_id,
            child_id=profile.child_id,
            consent_method="email",
            terms_version="1.0",
            expires_at=self.service.calculate_consent_expiry(datetime.now(UTC)),
        )
        await self.service.record_consent(consent)

        # Step 6: Verify consent updated profile
        updated = await self.service.get_child_profile(profile.child_id)
        assert updated.consent_status == ConsentStatus.VERIFIED

        # Step 7: Validate consent
        is_valid = self.service.validate_parental_consent(consent, "1.0")
        assert is_valid is True

        # Step 8: Get updated retention policy
        policy = self.service.get_retention_policy(8, ConsentStatus.VERIFIED)
        assert policy.value == "short_term"

    async def test_complete_data_deletion_workflow(self):
        """Test complete data deletion workflow."""
        parent_id = f"parent_{uuid.uuid4().hex[:8]}"

        # Create child profile
        profile = await self.service.create_child_profile(parent_account_id=parent_id, age=10)

        # Create session data with potential PII
        session_data = {
            "child_id": profile.child_id,
            "session_id": "sess_123",
            "name": "John Doe",  # PII - should be removed
            "email": "parent@example.com",  # PII - should be removed
            "wpm": 120,
            "accuracy_percent": 95.5,
        }

        # Sanitize data
        sanitized = self.service.sanitize_child_data(session_data)

        # Verify PII is removed
        assert "name" not in sanitized
        assert "email" not in sanitized
        assert sanitized["child_id"] == profile.child_id
        assert sanitized["wpm"] == 120

        # Verify audio should be deleted after 24 hours
        audio_time = datetime.now(UTC) - timedelta(hours=25)
        assert self.service.should_delete_audio(audio_time) is True


class TestServiceSingleton:
    """Test that coppa_service singleton exists."""

    def test_singleton_exists(self):
        """Test that coppa_service singleton is available."""
        from forge_shared.compliance.coppa import coppa_service

        assert coppa_service is not None
        assert isinstance(coppa_service, COPPAComplianceService)


class TestServiceIsolation:
    """Test that service instances are isolated."""

    async def test_different_instances_have_separate_state(self):
        """Test that separate service instances don't share state."""
        service1 = COPPAComplianceService()
        service2 = COPPAComplianceService()

        # Create profile in service1
        profile1 = await service1.create_child_profile("parent_1", 5)

        # Verify profile is not in service2
        profile2 = await service2.get_child_profile(profile1.child_id)
        assert profile2 is None


class TestEdgeCases:
    """Test edge cases and boundary conditions."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    async def test_child_profile_age_bounds(self):
        """Test creating profiles at age boundaries."""
        # Age 0
        profile = await self.service.create_child_profile("parent", 0)
        assert profile.age == 0

        # Age 18
        profile = await self.service.create_child_profile("parent", 18)
        assert profile.age == 18

    def test_verify_age_at_midnight_timezone(self):
        """Test age verification at timezone boundaries."""
        # Test with UTC time
        birth_date = datetime.now(UTC).replace(year=datetime.now(UTC).year - 10, month=1, day=1)
        is_verified, age_group = self.service.verify_age(birth_date=birth_date)
        assert is_verified is True

    async def test_consent_with_future_expiry(self):
        """Test consent with future expiry date."""
        future_date = datetime.now(UTC) + timedelta(days=400)
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent",
            child_id="child",
            consent_method="email",
            terms_version="1.0",
            expires_at=future_date,
        )

        is_valid = self.service.validate_parental_consent(consent, "1.0")
        assert is_valid is True

    async def test_consent_exactly_expired(self):
        """Test consent that expires exactly now."""
        consent = ParentalConsent(
            id="consent_123",
            parent_account_id="parent",
            child_id="child",
            consent_method="email",
            terms_version="1.0",
            expires_at=datetime.now(UTC) - timedelta(seconds=1),
        )

        is_valid = self.service.validate_parental_consent(consent, "1.0")
        assert is_valid is False


class TestPerformanceBenchmarks:
    """Test that operations complete within expected timeframes."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    async def test_age_verification_is_fast(self):
        """Test that age verification completes quickly."""
        import time

        start = time.time()
        for _ in range(1000):
            self.service.verify_age(age=10)
        elapsed = time.time() - start

        # Should complete 1000 verifications in under 1 second
        assert elapsed < 1.0

    async def test_data_sanitization_is_fast(self):
        """Test that data sanitization completes quickly."""
        import time

        data = {
            "name": "Test User",
            "email": "test@example.com",
            "child_id": "abc123",
            "session_id": "sess_123",
            "wpm": 120,
            "accuracy_percent": 95.5,
            "duration_seconds": 300,
            "completion_percent": 100.0,
        }

        start = time.time()
        for _ in range(1000):
            self.service.sanitize_child_data(data)
        elapsed = time.time() - start

        # Should complete 1000 sanitizations in under 1 second
        assert elapsed < 1.0


if __name__ == "__main__":
    pytest.main([__file__, "-v"])
