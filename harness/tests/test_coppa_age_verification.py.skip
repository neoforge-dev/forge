"""Tests for COPPA age verification functionality."""

from datetime import UTC, datetime, timedelta

import pytest

from forge_shared.compliance.coppa import (
    COPPAComplianceService,
    AgeGroup,
    ConsentStatus,
    DataRetentionPolicy,
)


class TestAgeVerification:
    """Test age verification functionality."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_verify_age_with_direct_age_child(self):
        """Test age verification for a child under 13."""
        is_verified, age_group = self.service.verify_age(age=10)

        assert is_verified is True
        assert age_group == AgeGroup.CHILD_UNDER_13

    def test_verify_age_with_direct_age_teen(self):
        """Test age verification for a teenager (13-15)."""
        is_verified, age_group = self.service.verify_age(age=14)

        assert is_verified is True
        assert age_group == AgeGroup.TEEN

    def test_verify_age_with_direct_age_adult(self):
        """Test age verification for an adult (16+)."""
        is_verified, age_group = self.service.verify_age(age=25)

        assert is_verified is True
        assert age_group == AgeGroup.ADULT

    def test_verify_age_boundary_12(self):
        """Test age verification at exactly 12 years old."""
        is_verified, age_group = self.service.verify_age(age=12)

        assert is_verified is True
        assert age_group == AgeGroup.CHILD_UNDER_13

    def test_verify_age_boundary_13(self):
        """Test age verification at exactly 13 years old."""
        is_verified, age_group = self.service.verify_age(age=13)

        assert is_verified is True
        assert age_group == AgeGroup.TEEN

    def test_verify_age_boundary_16(self):
        """Test age verification at exactly 16 years old."""
        is_verified, age_group = self.service.verify_age(age=16)

        assert is_verified is True
        assert age_group == AgeGroup.ADULT

    def test_verify_age_with_birth_date_child(self):
        """Test age verification with birth date for a child."""
        birth_date = datetime.now(UTC).replace(year=datetime.now(UTC).year - 8)
        is_verified, age_group = self.service.verify_age(birth_date=birth_date)

        assert is_verified is True
        assert age_group == AgeGroup.CHILD_UNDER_13

    def test_verify_age_with_birth_date_teen(self):
        """Test age verification with birth date for a teenager."""
        birth_date = datetime.now(UTC).replace(year=datetime.now(UTC).year - 14)
        is_verified, age_group = self.service.verify_age(birth_date=birth_date)

        assert is_verified is True
        assert age_group == AgeGroup.TEEN

    def test_verify_age_with_birth_date_adult(self):
        """Test age verification with birth date for an adult."""
        birth_date = datetime.now(UTC).replace(year=datetime.now(UTC).year - 30)
        is_verified, age_group = self.service.verify_age(birth_date=birth_date)

        assert is_verified is True
        assert age_group == AgeGroup.ADULT

    def test_verify_age_with_no_information(self):
        """Test age verification with no age or birth date provided."""
        is_verified, age_group = self.service.verify_age()

        assert is_verified is False
        assert age_group == AgeGroup.CHILD_UNDER_13

    def test_verify_age_with_none_age_and_birth_date(self):
        """Test age verification with None values."""
        is_verified, age_group = self.service.verify_age(age=None, birth_date=None)

        assert is_verified is False
        assert age_group == AgeGroup.CHILD_UNDER_13

    def test_verify_age_birthday_not_yet_this_year(self):
        """Test age calculation when birthday hasn't occurred yet this year."""
        today = datetime.now(UTC)
        birth_year = today.year - 10
        birth_date = (
            today.replace(month=today.month + 1, day=1)
            if today.month < 12
            else today.replace(month=1, day=1, year=birth_year - 1)
        )
        # Set birth date to next month (birthday hasn't occurred yet)
        birth_date = datetime.now(UTC).replace(
            year=today.year - 10, month=((today.month) % 12) + 1, day=1
        )

        is_verified, age_group = self.service.verify_age(birth_date=birth_date)
        # Should be 9, not 10, because birthday hasn't occurred yet
        assert is_verified is True
        assert age_group == AgeGroup.CHILD_UNDER_13

    def test_verify_age_birthday_already_this_year(self):
        """Test age calculation when birthday has already occurred this year."""
        birth_date = datetime.now(UTC).replace(year=datetime.now(UTC).year - 10, month=1, day=1)

        is_verified, age_group = self.service.verify_age(birth_date=birth_date)
        # Should be 10 because birthday has already occurred
        assert is_verified is True
        assert age_group == AgeGroup.CHILD_UNDER_13

    def test_verify_age_extreme_values(self):
        """Test age verification with extreme age values."""
        # Age 0
        is_verified, age_group = self.service.verify_age(age=0)
        assert is_verified is True
        assert age_group == AgeGroup.CHILD_UNDER_13

        # Age 18 (max child age)
        is_verified, age_group = self.service.verify_age(age=18)
        assert is_verified is True
        assert age_group == AgeGroup.ADULT


class TestIsMinor:
    """Test is_minor helper function."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_is_minor_under_13(self):
        """Test that users under 13 are identified as minors."""
        assert self.service.is_minor(age=5) is True
        assert self.service.is_minor(age=12) is True

    def test_is_minor_at_13(self):
        """Test that users at 13 are not identified as COPPA minors."""
        assert self.service.is_minor(age=13) is False

    def test_is_minor_over_13(self):
        """Test that users over 13 are not identified as minors."""
        assert self.service.is_minor(age=14) is False
        assert self.service.is_minor(age=20) is False
        assert self.service.is_minor(age=100) is False

    def test_is_minor_with_birth_date(self):
        """Test is_minor with birth date."""
        birth_date = datetime.now(UTC).replace(year=datetime.now(UTC).year - 10)
        assert self.service.is_minor(birth_date=birth_date) is True

        birth_date = datetime.now(UTC).replace(year=datetime.now(UTC).year - 15)
        assert self.service.is_minor(birth_date=birth_date) is False

    def test_is_minor_with_none(self):
        """Test is_minor with None values defaults to True."""
        assert self.service.is_minor() is True


class TestConsentRequirement:
    """Test is_consent_required helper function."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_consent_required_for_child(self):
        """Test that consent is required for children under 13."""
        assert self.service.is_consent_required(age=5) is True
        assert self.service.is_consent_required(age=10) is True
        assert self.service.is_consent_required(age=12) is True

    def test_consent_not_required_for_teen(self):
        """Test that consent is not required for teens 13+."""
        assert self.service.is_consent_required(age=13) is False
        assert self.service.is_consent_required(age=16) is False
        assert self.service.is_consent_required(age=18) is False

    def test_consent_required_when_age_unknown(self):
        """Test that consent is required when age is unknown."""
        assert self.service.is_consent_required(age=None) is True


class TestAgeGroupEnum:
    """Test AgeGroup enum values."""

    def test_enum_values(self):
        """Test that AgeGroup enum has expected values."""
        assert AgeGroup.CHILD_UNDER_13.value == "under_13"
        assert AgeGroup.CHILD_13_PLUS.value == "13_plus"
        assert AgeGroup.TEEN.value == "teen"
        assert AgeGroup.ADULT.value == "adult"

    def test_enum_is_string(self):
        """Test that AgeGroup inherits from str."""
        assert isinstance(AgeGroup.CHILD_UNDER_13, str)
        assert isinstance(AgeGroup.TEEN, str)


class TestConsentStatusEnum:
    """Test ConsentStatus enum values."""

    def test_enum_values(self):
        """Test that ConsentStatus enum has expected values."""
        assert ConsentStatus.PENDING.value == "pending"
        assert ConsentStatus.VERIFIED.value == "verified"
        assert ConsentStatus.EXPIRED.value == "expired"
        assert ConsentStatus.WITHDRAWN.value == "withdrawn"

    def test_enum_is_string(self):
        """Test that ConsentStatus inherits from str."""
        assert isinstance(ConsentStatus.PENDING, str)
        assert isinstance(ConsentStatus.VERIFIED, str)


class TestDataRetentionPolicyEnum:
    """Test DataRetentionPolicy enum values."""

    def test_enum_values(self):
        """Test that DataRetentionPolicy enum has expected values."""
        assert DataRetentionPolicy.IMMEDIATE_DELETE.value == "immediate"
        assert DataRetentionPolicy.SHORT_TERM.value == "short_term"
        assert DataRetentionPolicy.MEDIUM_TERM.value == "medium_term"
        assert DataRetentionPolicy.LONG_TERM.value == "long_term"

    def test_enum_is_string(self):
        """Test that DataRetentionPolicy inherits from str."""
        assert isinstance(DataRetentionPolicy.IMMEDIATE_DELETE, str)
        assert isinstance(DataRetentionPolicy.LONG_TERM, str)


if __name__ == "__main__":
    pytest.main([__file__, "-v"])
