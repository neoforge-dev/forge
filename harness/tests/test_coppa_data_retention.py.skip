class TestSessionDataRetention:
    """Test session data retention policies."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_should_delete_session_data_fresh(self):
        """Test that fresh session data should not be deleted."""
        session_time = datetime.now(UTC)
        should_delete = self.service.should_delete_session_data(session_time)
        assert should_delete is False

    def test_should_delete_session_data_after_30_days(self):
        """Test that session data after 30 days should be deleted."""
        session_time = datetime.now(UTC) - timedelta(days=31)
        should_delete = self.service.should_delete_session_data(session_time)
        assert should_delete is True

    def test_should_delete_session_data_at_29_days(self):
        """Test that session data at 29 days should not be deleted."""
        session_time = datetime.now(UTC) - timedelta(days=29)
        should_delete = self.service.should_delete_session_data(session_time)
        assert should_delete is False


class TestDataRetentionPolicyEnum:
    """Test DataRetentionPolicy enum values."""

    def test_immediate_delete_policy(self):
        """Test IMMEDIATE_DELETE policy value."""
        assert DataRetentionPolicy.IMMEDIATE_DELETE.value == "immediate"

    def test_short_term_policy(self):
        """Test SHORT_TERM policy value."""
        assert DataRetentionPolicy.SHORT_TERM.value == "short_term"

    def test_medium_term_policy(self):
        """Test MEDIUM_TERM policy value."""
        assert DataRetentionPolicy.MEDIUM_TERM.value == "medium_term"

    def test_long_term_policy(self):
        """Test LONG_TERM policy value."""
        assert DataRetentionPolicy.LONG_TERM.value == "long_term"


class TestGetRetentionPolicy:
    """Test get_retention_policy functionality."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_no_consent_immediate_delete(self):
        """Test that unverified consent results in immediate deletion."""
        policy = self.service.get_retention_policy(age=10, consent_status=ConsentStatus.PENDING)
        assert policy == DataRetentionPolicy.IMMEDIATE_DELETE

    def test_withdrawn_consent_immediate_delete(self):
        """Test that withdrawn consent results in immediate deletion."""
        policy = self.service.get_retention_policy(age=10, consent_status=ConsentStatus.WITHDRAWN)
        assert policy == DataRetentionPolicy.IMMEDIATE_DELETE

    def test_expired_consent_immediate_delete(self):
        """Test that expired consent results in immediate deletion."""
        policy = self.service.get_retention_policy(age=10, consent_status=ConsentStatus.EXPIRED)
        assert policy == DataRetentionPolicy.IMMEDIATE_DELETE

    def test_young_child_short_term(self):
        """Test retention for child under 10 with consent."""
        policy = self.service.get_retention_policy(age=5, consent_status=ConsentStatus.VERIFIED)
        assert policy == DataRetentionPolicy.SHORT_TERM

    def test_young_child_exact_10(self):
        """Test retention for child exactly 10 with consent.

        Note: Age 10 falls into MEDIUM_TERM since the condition is age < 10 for SHORT_TERM.
        """
        policy = self.service.get_retention_policy(age=10, consent_status=ConsentStatus.VERIFIED)
        assert policy == DataRetentionPolicy.MEDIUM_TERM

    def test_older_child_medium_term(self):
        """Test retention for child 10-12 with consent."""
        policy = self.service.get_retention_policy(age=11, consent_status=ConsentStatus.VERIFIED)
        assert policy == DataRetentionPolicy.MEDIUM_TERM

    def test_teen_long_term(self):
        """Test retention for teen 13+ with consent."""
        policy = self.service.get_retention_policy(age=15, consent_status=ConsentStatus.VERIFIED)
        assert policy == DataRetentionPolicy.LONG_TERM


class TestDataSanitization:
    """Test child data sanitization functionality."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_sanitize_removes_name(self):
        """Test that real names are removed."""
        data = {
            "name": "John Doe",
            "child_id": "abc123",
            "wpm": 120,
        }
        result = self.service.sanitize_child_data(data)
        assert "name" not in result
        assert "child_id" in result
        assert "wpm" in result

    def test_sanitize_removes_email(self):
        """Test that email addresses are removed."""
        data = {
            "email": "parent@example.com",
            "child_id": "abc123",
            "accuracy_percent": 95.5,
        }
        result = self.service.sanitize_child_data(data)
        assert "email" not in result
        assert "child_id" in result
        assert "accuracy_percent" in result

    def test_sanitize_removes_phone(self):
        """Test that phone numbers are removed."""
        data = {
            "phone": "+1234567890",
            "child_id": "abc123",
            "duration_seconds": 300,
        }
        result = self.sanitized_data = self.service.sanitize_child_data(data)
        assert "phone" not in result
        assert "child_id" in result

    def test_sanitize_removes_address(self):
        """Test that addresses are removed."""
        data = {
            "address": "123 Main St",
            "child_id": "abc123",
            "expression_score": 8.5,
        }
        result = self.service.sanitize_child_data(data)
        assert "address" not in result
        assert "child_id" in result

    def test_sanitize_removes_audio_fields(self):
        """Test that audio/voice recording fields are removed."""
        data = {
            "audio_url": "https://storage.example.com/audio.mp3",
            "audio_recording": b"binary data",
            "voice_recording": "base64 encoded",
            "child_id": "abc123",
        }
        result = self.service.sanitize_child_data(data)
        assert "audio_url" not in result
        assert "audio_recording" not in result
        assert "voice_recording" not in result
        assert "child_id" in result

    def test_sanitize_removes_transcript(self):
        """Test that transcripts are removed."""
        data = {
            "transcript": "Hello, my name is...",
            "child_id": "abc123",
        }
        result = self.service.sanitize_child_data(data)
        assert "transcript" not in result
        assert "child_id" in result

    def test_sanitize_removes_ip_address(self):
        """Test that IP addresses are removed."""
        data = {
            "ip_address": "192.168.1.1",
            "child_id": "abc123",
        }
        result = self.service.sanitize_child_data(data)
        assert "ip_address" not in result
        assert "child_id" in result

    def test_sanitize_retains_safe_fields(self):
        """Test that safe fields are retained."""
        data = {
            "child_id": "abc123",
            "session_id": "sess_xyz",
            "session_timestamp": "2026-02-11T10:00:00Z",
        }
        result = self.service.sanitize_child_data(data)
        assert result["child_id"] == "abc123"
        assert result["session_id"] == "sess_xyz"
        assert result["session_timestamp"] == "2026-02-11T10:00:00Z"

    def test_sanitize_retains_metrics(self):
        """Test that aggregated metrics are retained."""
        data = {
            "wpm": 120,
            "accuracy_percent": 95.5,
            "expression_score": 8.5,
            "duration_seconds": 300,
            "completion_percent": 100.0,
            "grade_level_estimate": 5.2,
            "practice_minutes": 15,
            "sessions_completed": 42,
            "streak_days": 7,
        }
        result = self.service.sanitize_child_data(data)
        assert result["wpm"] == 120
        assert result["accuracy_percent"] == 95.5
        assert result["expression_score"] == 8.5
        assert result["duration_seconds"] == 300

    def test_sanitize_without_metrics(self):
        """Test sanitization without retaining metrics."""
        data = {
            "name": "John Doe",
            "wpm": 120,
            "child_id": "abc123",
        }
        result = self.service.sanitize_child_data(data, retain_metrics=False)
        assert "name" not in result
        assert "wpm" not in result
        assert "child_id" in result

    def test_sanitize_handles_nested_dicts(self):
        """Test sanitization of nested dictionaries."""
        data = {
            "outer": {
                "name": "John Doe",  # Should be removed
                "score": 100,  # Should be retained (not PII, not safe field)
            },
            "child_id": "abc123",  # Should be retained
        }
        result = self.service.sanitize_child_data(data)
        # Only child_id should remain since name is PII and score is neither PII nor safe/metric
        assert result == {"child_id": "abc123"}

    def test_sanitize_case_insensitive(self):
        """Test that PII removal is case insensitive."""
        data = {
            "NAME": "John Doe",
            "Email": "john@example.com",
            "child_id": "abc123",
        }
        result = self.service.sanitize_child_data(data)
        assert "NAME" not in result
        assert "Email" not in result
        assert "child_id" in result

    def test_sanitize_removes_ssn(self):
        """Test that SSN is removed."""
        data = {
            "ssn": "123-45-6789",
            "child_id": "abc123",
        }
        result = self.service.sanitize_child_data(data)
        assert "ssn" not in result
        assert "child_id" in result

    def test_sanitize_removes_birth_date(self):
        """Test that birth date is removed."""
        data = {
            "birth_date": "2015-05-15",
            "full_birth_date": "May 15, 2015",
            "child_id": "abc123",
        }
        result = self.service.sanitize_child_data(data)
        assert "birth_date" not in result
        assert "full_birth_date" not in result
        assert "child_id" in result


class TestRetentionConfiguration:
    """Test retention period configuration."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_audio_retention_is_24_hours(self):
        """Test that audio retention is set to 24 hours."""
        assert self.service.AUDIO_RETENTION_HOURS == 24

    def test_transcript_retention_is_24_hours(self):
        """Test that transcript retention is set to 24 hours."""
        assert self.service.TRANSCRIPT_RETENTION_HOURS == 24

    def test_session_data_retention_is_30_days(self):
        """Test that session data retention is set to 30 days."""
        assert self.service.SESSION_DATA_RETENTION_DAYS == 30

    def test_metrics_retention_is_365_days(self):
        """Test that aggregated metrics retention is set to 365 days."""
        assert self.service.METRICS_RETENTION_DAYS == 365


if __name__ == "__main__":
    pytest.main([__file__, "-v"])
