"""Tests for COPPA data retention functionality."""

from datetime import UTC, datetime, timedelta

import pytest

from forge_shared.compliance.coppa import (
    COPPAComplianceService,
    ConsentStatus,
    DataRetentionPolicy,
)


class TestAudioRetention:
    """Test audio/voice recording retention policies."""

    def setup_method(self):
        """Set up test fixtures."""
        self.service = COPPAComplianceService()

    def test_should_delete_audio_fresh(self):
        """Test that fresh audio should not be deleted."""
        upload_time = datetime.now(UTC)
        should_delete = self.service.should_delete_audio(upload_time)
        assert should_delete is False

    def test_should_delete_audio_after_23_hours(self):
        """Test that audio at 23 hours should not be deleted."""
        upload_time = datetime.now(UTC) - timedelta(hours=23)
        should_delete = self.service.should_delete_audio(upload_time)
        assert should_delete is False

    def test_should_delete_audio_after_25_hours(self):
        """Test that audio at 25 hours should be deleted (COPPA requirement)."""
        upload_time = datetime.now(UTC) - timedelta(hours=25)
        should_delete = self.service.should_delete_audio(upload_time)
        assert should_delete is True

    def test_should_delete_audio_exactly_at_24_hours(self):
        """Test audio retention at exactly 24 hours."""
        upload_time = datetime.now(UTC) - timedelta(hours=24)
        should_delete = self.service.should_delete_audio(upload_time)
        # At exactly 24 hours, it should be deleted
        assert should_delete is True

    def test_should_delete_audio_with_naive_datetime(self):
        """Test audio deletion with naive datetime (no timezone)."""
        # Create a timezone-aware datetime 25 hours ago
        upload_time = datetime.now(UTC) - timedelta(hours=25)
        should_delete = self.service.should_delete_audio(upload_time)
        assert should_delete is True


