"""
Tests for content sequence automation module.
"""

from datetime import datetime

import pytest
from forge_shared.marketing.content_sequence import (
    Channel,
    ContentSequence,
    DistributionScheduler,
    MultiChannelDistributor,
    SequenceSchedule,
    SequenceStep,
    SequenceTemplate,
    create_sequence,
    format_content,
    schedule_sequence,
)


class TestDistributionScheduler:
    """Tests for DistributionScheduler."""

    @pytest.fixture
    def scheduler(self):
        """Create a scheduler instance."""
        return DistributionScheduler(timezone="America/New_York")

    def test_scheduler_initialization(self, scheduler):
        """Test scheduler creation."""
        assert scheduler.timezone == "America/New_York"
        assert Channel.EMAIL in scheduler.OPTIMAL_TIMES

    def test_optimal_times_configured(self, scheduler):
        """Test that optimal times are set for all channels."""
        for channel in Channel:
            assert channel in scheduler.OPTIMAL_TIMES

    def test_weekend_adjustment(self, scheduler):
        """Test weekend date adjustment."""
        # Saturday (weekday 5)
        saturday = datetime(2026, 2, 15, 10, 0, 0)  # Feb 15, 2026 is Saturday
        adjusted = scheduler._adjust_for_weekends(saturday)
        # Should move to Monday
        assert adjusted.weekday() == 0  # Monday
        assert adjusted.day >= 16  # After Saturday

    def test_calculate_scheduled_time(self, scheduler):
        """Test scheduled time calculation."""
        start = datetime(2026, 2, 10, 9, 0, 0)
        scheduled = scheduler._calculate_scheduled_time(
            start, day_offset=2, delay_hours=0, channel=Channel.EMAIL
        )
        # Should be 2 days later at 9 AM (optimal time for email)
        assert scheduled.day == 12
        assert scheduled.hour == 9

    def test_create_schedule_basic(self, scheduler):
        """Test schedule creation from a sequence."""
        sequence = ContentSequence(
            name="Test Sequence",
            template=SequenceTemplate.WELCOME,
            channels=[Channel.EMAIL, Channel.SLACK],
            steps=[
                SequenceStep(
                    step_number=1,
                    day_offset=0,
                    channel=Channel.EMAIL,
                    content_type="email",
                    subject="Welcome",
                ),
                SequenceStep(
                    step_number=2,
                    day_offset=1,
                    channel=Channel.SLACK,
                    content_type="message",
                    subject=None,
                ),
            ],
        )

        schedule = scheduler.create_schedule(sequence)

        assert schedule.sequence_name == "Test Sequence"
        assert schedule.total_steps == 2
        assert len(schedule.scheduled_items) == 2
        assert schedule.scheduled_items[0]["channel"] == "email"
        assert schedule.scheduled_items[1]["channel"] == "slack"


class TestSequenceTemplates:
    """Tests for sequence template generation."""

    @pytest.fixture
    def scheduler(self):
        """Create a scheduler instance."""
        return DistributionScheduler()

    def test_generate_welcome_template(self, scheduler):
        """Test welcome sequence generation."""
        sequence = scheduler.generate_template(SequenceTemplate.WELCOME, "My Welcome")

        assert sequence.name == "My Welcome"
        assert sequence.template == SequenceTemplate.WELCOME
        assert len(sequence.steps) == 2
        assert Channel.EMAIL in sequence.channels
        assert Channel.SLACK in sequence.channels

    def test_generate_lead_nurture_template(self, scheduler):
        """Test lead nurture sequence generation."""
        sequence = scheduler.generate_template(SequenceTemplate.LEAD_NURTURE)

        assert sequence.template == SequenceTemplate.LEAD_NURTURE
        assert len(sequence.steps) == 5
        assert Channel.EMAIL in sequence.channels
        assert Channel.LINKEDIN in sequence.channels
        assert Channel.TWITTER in sequence.channels

    def test_generate_product_launch_template(self, scheduler):
        """Test product launch sequence generation."""
        sequence = scheduler.generate_template(SequenceTemplate.PRODUCT_LAUNCH)

        assert sequence.template == SequenceTemplate.PRODUCT_LAUNCH
        assert len(sequence.steps) == 6
        assert Channel.FACEBOOK in sequence.channels

    def test_generate_webinar_promotion_template(self, scheduler):
        """Test webinar promotion sequence generation."""
        sequence = scheduler.generate_template(SequenceTemplate.WEBINAR_PROMOTION)

        assert sequence.template == SequenceTemplate.WEBINAR_PROMOTION
        assert len(sequence.steps) == 6
        assert Channel.NEWSLETTER in sequence.channels

    def test_generate_onboarding_template(self, scheduler):
        """Test onboarding sequence generation."""
        sequence = scheduler.generate_template(SequenceTemplate.ONBOARDING)

        assert sequence.template == SequenceTemplate.ONBOARDING
        assert len(sequence.steps) == 5
        assert Channel.SLACK in sequence.channels

    def test_get_template_info(self, scheduler):
        """Test template info retrieval."""
        info = scheduler.get_template_info(SequenceTemplate.LEAD_NURTURE)

        assert info["template"] == "lead_nurture"
        assert "email" in info["channels"]
        assert info["step_count"] == 5
        assert info["duration_days"] == 11  # Last step is day 10


class TestMultiChannelDistributor:
    """Tests for MultiChannelDistributor."""

    @pytest.fixture
    def distributor(self):
        """Create a distributor instance."""
        return MultiChannelDistributor()

    def test_twitter_format_truncates_long_content(self, distributor):
        """Test Twitter formatting truncates over 280 chars."""
        long_content = "A" * 300
        formatted = distributor._format_twitter(long_content)
        assert len(formatted) <= 280

    def test_twitter_format_preserves_short_content(self, distributor):
        """Test Twitter formatting preserves short content."""
        short_content = "Hello Twitter!"
        formatted = distributor._format_twitter(short_content)
        assert formatted == short_content

    def test_email_format_adds_paragraphs(self, distributor):
        """Test email formatting adds paragraph spacing."""
        single_line = "This is a sentence. This is another sentence."
        formatted = distributor._format_email(single_line)
        assert "\n" in formatted

    def test_format_for_channel_with_variables(self, distributor):
        """Test content formatting with variable substitution."""
        content = "Hello {{name}}! Welcome to {{company}}."
        formatted = distributor.format_for_channel(
            content,
            Channel.EMAIL,
            {"name": "John", "company": "Acme"},
        )
        assert "John" in formatted
        assert "Acme" in formatted

    def test_extract_hashtags(self, distributor):
        """Test hashtag extraction."""
        content = "Check out #Python and #AI for #MachineLearning"
        tags = distributor.extract_hashtags(content)
        assert len(tags) == 3
        assert "#Python" in tags
        assert "#AI" in tags

    def test_generate_hashtags_twitter(self, distributor):
        """Test hashtag generation for Twitter."""
        tags = distributor.generate_hashtags("technical debt", Channel.TWITTER, count=3)
        assert len(tags) == 3
        assert "#technicaldebt" in tags


class TestConvenienceFunctions:
    """Tests for module-level convenience functions."""

    def test_create_sequence(self):
        """Test create_sequence convenience function."""
        sequence = create_sequence("My Welcome", SequenceTemplate.WELCOME, "UTC")

        assert sequence.name == "My Welcome"
        assert sequence.template == SequenceTemplate.WELCOME

    def test_schedule_sequence(self):
        """Test schedule_sequence convenience function."""
        sequence = create_sequence("Test", SequenceTemplate.WELCOME)
        schedule = schedule_sequence(sequence)

        assert isinstance(schedule, SequenceSchedule)
        assert schedule.total_steps == len(sequence.steps)

    def test_format_content(self):
        """Test format_content convenience function."""
        formatted = format_content("Hi {{name}}!", Channel.EMAIL, {"name": "Alice"})
        assert "Alice" in formatted


class TestContentSequence:
    """Tests for ContentSequence model."""

    def test_sequence_creation(self):
        """Test creating a content sequence."""
        sequence = ContentSequence(
            name="Test Sequence",
            channels=[Channel.EMAIL],
            steps=[
                SequenceStep(
                    step_number=1,
                    day_offset=0,
                    channel=Channel.EMAIL,
                    content_type="email",
                    subject="Test",
                ),
            ],
        )

        assert sequence.name == "Test Sequence"
        assert sequence.status == "draft"
        assert len(sequence.steps) == 1

    def test_sequence_with_custom_timing(self):
        """Test sequence with custom timing."""
        sequence = ContentSequence(
            name="Custom Timing",
            start_date=datetime(2026, 3, 1),
            timezone="America/Los_Angeles",
            channels=[Channel.LINKEDIN],
        )

        assert sequence.timezone == "America/Los_Angeles"
        assert sequence.start_date == datetime(2026, 3, 1)


class TestSequenceStep:
    """Tests for SequenceStep model."""

    def test_step_creation(self):
        """Test creating a sequence step."""
        step = SequenceStep(
            step_number=1,
            day_offset=3,
            channel=Channel.EMAIL,
            content_type="email",
            subject="Follow-up",
            body_template="follow_up_email",
        )

        assert step.step_number == 1
        assert step.day_offset == 3
        assert step.channel == Channel.EMAIL
        assert step.triggered is False

    def test_step_with_delay(self):
        """Test step with within-day delay."""
        step = SequenceStep(
            step_number=2,
            day_offset=0,
            channel=Channel.TWITTER,
            content_type="tweet",
            subject=None,
            delay_hours=6,
        )

        assert step.delay_hours == 6


class TestChannelEnum:
    """Tests for Channel enum."""

    def test_all_channels_defined(self):
        """Test all expected channels are defined."""
        channels = [c.value for c in Channel]

        assert "email" in channels
        assert "linkedin" in channels
        assert "twitter" in channels
        assert "facebook" in channels
        assert "instagram" in channels
        assert "blog" in channels
        assert "slack" in channels
        assert "discord" in channels
