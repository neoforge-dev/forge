#!/usr/bin/env bash
# node-migrate-v3 — run this on any non-prya node to migrate from v2 harness to v3+CLI v4
#
# Architecture: prya runs the single v3 daemon. All nodes connect to it via Tailscale.
#   FORGE_API_URL=http://prya:8081
#
# Usage:
#   bash bin/node-migrate-v3
#
# Safe to run multiple times (idempotent).

set -euo pipefail

NODE_ID="${NODE_ID:-$(hostname -s)}"
FORGE_ROOT="${FORGE_ROOT:-$HOME/FORGE}"
PRYA_API="http://prya:8081"

echo "=== FORGE v3 migration: ${NODE_ID} → prya:8081 ==="
echo "FORGE_ROOT=${FORGE_ROOT}"
echo "API hub   =${PRYA_API}"

cd "$FORGE_ROOT"

# --- 1. Pull latest ---
echo ""
echo "[1/5] Pulling latest code..."
# Stash any local changes so rebase succeeds (idempotent-safe)
git stash --quiet 2>/dev/null || true
git pull --rebase
git stash pop --quiet 2>/dev/null || true

# --- 2. Kill old v2 harness work loops (NOT the CC server on prya) ---
echo ""
echo "[2/5] Stopping old v2 harness work loops..."
pkill -f "forge_harness.cli_v2.*work" 2>/dev/null && echo "  stopped harness work loops" || echo "  none running"
pkill -f "forge-harness.*work"        2>/dev/null || true

# --- 3. Build CLI v4 ---
echo ""
echo "[3/5] Building CLI v4..."
cd "${FORGE_ROOT}/cmd/forge"
go build -o forge .
echo "  built: ${FORGE_ROOT}/cmd/forge/forge"

# Install to PATH
if [ -w /usr/local/bin ]; then
    cp forge /usr/local/bin/forge && echo "  installed: /usr/local/bin/forge"
elif [ -w "$HOME/.local/bin" ]; then
    mkdir -p "$HOME/.local/bin"
    cp forge "$HOME/.local/bin/forge" && echo "  installed: $HOME/.local/bin/forge"
else
    echo "  NOTE: add ${FORGE_ROOT}/cmd/forge to PATH permanently"
fi

cd "$FORGE_ROOT"

# --- 4. Verify connectivity to prya ---
echo ""
echo "[4/5] Checking Tailscale connectivity to prya..."
if curl -sf --max-time 5 "${PRYA_API}/health" > /dev/null; then
    echo "  ✅ prya:8081 reachable"
else
    echo "  ❌ Cannot reach ${PRYA_API}"
    echo "     Check: tailscale status | grep prya"
    echo "     Ensure prya daemon is running: ssh prya 'curl http://localhost:8081/health'"
    exit 1
fi

# --- 5. Verify CLI v4 works against prya ---
echo ""
echo "[5/5] Verifying forge CLI v4..."
export FORGE_API_URL="${PRYA_API}"
if FORGE_API_URL="${PRYA_API}" forge task list > /dev/null 2>&1; then
    echo "  ✅ forge task list working against prya"
else
    echo "  ⚠️  forge CLI connected but task list returned error (daemon may be warming up)"
fi

# --- Done ---
echo ""
echo "=== Migration complete for ${NODE_ID} ==="
echo ""
echo "Add to your shell profile (~/.bashrc or ~/.zshrc) on ${NODE_ID}:"
echo ""
echo "  export FORGE_ROOT=${FORGE_ROOT}"
echo "  export FORGE_API_URL=${PRYA_API}"
echo "  export PATH=\"\${FORGE_ROOT}/cmd/forge:\${PATH}\""
echo ""
echo "Start agent work loop:"
echo "  FORGE_AGENT_TYPE=fleet FORGE_AGENT_NAME=<name> forge work --daemon"
echo ""
echo "Verify queue:"
echo "  FORGE_API_URL=${PRYA_API} forge task list"
echo "  FORGE_API_URL=${PRYA_API} forge agent list"
