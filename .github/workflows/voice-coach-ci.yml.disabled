name: Voice Coach CI

on:
  push:
    branches: [main, develop]
    paths:
      - 'brandfocus-ai/voice-coach/app/**'
      - '.github/workflows/voice-coach-ci.yml'
      - '.github/workflows/reusable-backend-ci.yml'
      - '.github/workflows/reusable-frontend-ci.yml'
  pull_request:
    branches: [main, develop]
    paths:
      - 'brandfocus-ai/voice-coach/app/**'
      - '.github/workflows/voice-coach-ci.yml'

jobs:
  backend-ci:
    name: Backend CI
    uses: ./.github/workflows/reusable-backend-ci.yml
    with:
      project_path: 'brandfocus-ai/voice-coach/app/backend'
      python_version: '3.12'
      coverage_threshold: 70
      enable_mypy: true
      enable_docker_build: true

  frontend-ci:
    name: Frontend CI
    uses: ./.github/workflows/reusable-frontend-ci.yml
    with:
      project_path: 'brandfocus-ai/voice-coach/app/frontend'
      node_version: '20'
      enable_tests: true
      build_env_vars: '{"VITE_API_URL": "https://api.example.com"}'
