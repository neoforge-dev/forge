name: V4 CLI Quality Gates
on:
  pull_request:
    paths:
      - 'cmd/forge/**'
      - '.github/workflows/v4-quality-gates.yml'
  push:
    branches: [main]
    paths:
      - 'cmd/forge/**'

jobs:
  quality-gates:
    name: V4 CLI Quality Gates
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Go
        uses: actions/setup-go@v5
        with:
          go-version: '1.21'

      - name: Build
        run: |
          cd cmd/forge
          go build -o forge .
          echo "✓ Build successful"

      - name: Run Tests
        run: |
          cd cmd/forge
          go test -v -race ./... 2>&1 | tee /tmp/test-output.txt
          if [ ${PIPESTATUS[0]} -ne 0 ]; then
            echo "❌ Tests failed"
            exit 1
          fi
          echo "✓ All tests pass"

      - name: Check Coverage
        run: |
          cd cmd/forge
          go test -coverprofile=coverage.out ./...
          
          # Check overall coverage
          OVERALL=$(go tool cover -func=coverage.out | grep total | awk '{print $3}' | sed 's/%//')
          echo "Overall coverage: ${OVERALL}%"
          
          # Fail if below 60%
          if (( $(echo "$OVERALL < 60" | bc -l) )); then
            echo "❌ Coverage ${OVERALL}% below 60% threshold"
            exit 1
          fi
          echo "✓ Coverage ${OVERALL}% meets 60% threshold"

      - name: Check P0 Feature Coverage
        run: |
          cd cmd/forge
          
          # Critical features that must have tests
          CRITICAL_FEATURES=("queue" "websocket" "domain" "approval" "dispatch")
          
          for feature in "${CRITICAL_FEATURES[@]}"; do
            # Check if test file exists
            if ls *${feature}*test*.go >/dev/null 2>&1 || ls internal/**/*${feature}*test*.go >/dev/null 2>&1; then
              echo "✓ ${feature} has tests"
            else
              echo "❌ ${feature} missing tests"
              exit 1
            fi
          done

      - name: Vet Code
        run: |
          cd cmd/forge
          go vet ./...
          echo "✓ go vet passed"

      - name: Check Format
        run: |
          cd cmd/forge
          if [ -n "$(gofmt -l .)" ]; then
            echo "❌ Code not formatted:"
            gofmt -l .
            exit 1
          fi
          echo "✓ Code formatted"

      - name: Upload Coverage Report
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: coverage-report
          path: cmd/forge/coverage.out

  blocking-check:
    name: Block Merge Check
    runs-on: ubuntu-latest
    needs: quality-gates
    if: github.event_name == 'pull_request'
    steps:
      - name: Check P0 Blockers
        run: |
          # List known P0 features without tests
          MISSING_TESTS=""
          
          # Check queue_test.go
          if [ ! -f "cmd/forge/queue_test.go" ]; then
            MISSING_TESTS="${MISSING_TESTS}queue_test.go "
          fi
          
          # Check lane_test.go  
          if [ ! -f "cmd/forge/lane_test.go" ]; then
            MISSING_TESTS="${MISSING_TESTS}lane_test.go "
          fi
          
          if [ -n "$MISSING_TESTS" ]; then
            echo "❌ BLOCKING: Missing critical test files: ${MISSING_TESTS}"
            echo "See: .forge/heartbeat/V4-CLI-TDD-STATUS-20260305.md"
            exit 1
          fi
          
          echo "✓ All critical tests present"
