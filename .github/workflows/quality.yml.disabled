name: Quality Gates

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    # Weekly scan: Every Sunday at 6:00 UTC
    - cron: '0 6 * * 0'
  workflow_dispatch:
    inputs:
      project:
        description: 'Specific project to scan (optional)'
        required: false
        type: string
      threshold:
        description: 'Minimum quality score threshold'
        required: false
        default: '50'
        type: string
      generate_features:
        description: 'Generate features.json from scan results'
        required: false
        default: false
        type: boolean

jobs:
  quality-scan:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Full history for trend analysis

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "latest"

      - name: Install harness dependencies
        run: |
          cd harness
          uv sync

      - name: Install security tools
        run: |
          cd harness
          uv add bandit radon

      - name: Run quality scan
        id: scan
        run: |
          cd harness
          uv run python -c "
          import asyncio
          import json
          import os
          import sys
          from pathlib import Path

          # Add parent to path for imports
          sys.path.insert(0, str(Path.cwd()))

          from forge_harness.quality_loop import create_quality_loop, QualityConfig

          async def run_scan():
              # Get threshold from input or default
              threshold = float(os.getenv('QUALITY_THRESHOLD', '50'))
              project_filter = os.getenv('PROJECT_FILTER', '')

              config = QualityConfig(
                  min_coverage=70.0,
                  max_complexity=20.0,
                  degradation_threshold=5.0,
              )

              loop = create_quality_loop(
                  forge_root=Path('..'),
                  metrics_dir=Path('../quality_metrics'),
                  config=config,
              )

              # Discover and scan projects
              projects = await loop.discover_projects()

              # Filter if specific project requested
              if project_filter:
                  projects = [p for p in projects if p['name'] == project_filter]
                  if not projects:
                      print(f'::error::Project {project_filter} not found')
                      return 1

              # Run portfolio scan
              report = await loop.run_portfolio_scan(projects)

              # Output results
              print(f'::notice::Portfolio Quality Score: {report.average_quality_score:.1f}/100')
              print(f'::notice::Projects Scanned: {report.projects_scanned}')
              print(f'::notice::Critical Issues: {report.critical_issues}')
              print(f'::notice::High Issues: {report.high_issues}')

              # Check for degraded projects
              if report.degraded_projects:
                  for proj in report.degraded_projects:
                      print(f'::warning::Project {proj.project_name} degraded: {proj.previous_score:.1f} -> {proj.quality_score:.1f}')

              # Check threshold
              if report.average_quality_score < threshold:
                  print(f'::error::Quality score {report.average_quality_score:.1f} below threshold {threshold}')
                  return 1

              # Check for critical security issues
              if report.critical_issues > 0:
                  print(f'::error::{report.critical_issues} critical security issues found')
                  return 1

              # Save report
              report_path = Path('../quality_metrics/ci_report.json')
              report_path.parent.mkdir(parents=True, exist_ok=True)
              report_path.write_text(json.dumps(report.to_dict(), indent=2, default=str))

              print('::notice::Quality gates passed!')
              return 0

          exit_code = asyncio.run(run_scan())
          sys.exit(exit_code)
          "
        env:
          QUALITY_THRESHOLD: ${{ inputs.threshold || '50' }}
          PROJECT_FILTER: ${{ inputs.project || '' }}

      - name: Upload quality report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: quality-report
          path: quality_metrics/ci_report.json
          retention-days: 30

      - name: Comment PR with results
        if: github.event_name == 'pull_request' && always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            let report = {};
            try {
              report = JSON.parse(fs.readFileSync('quality_metrics/ci_report.json', 'utf8'));
            } catch (e) {
              report = { average_quality_score: 'N/A', projects_scanned: 0 };
            }

            const score = report.average_quality_score || 'N/A';
            const emoji = score >= 80 ? '✅' : score >= 60 ? '⚠️' : '❌';

            const body = `## ${emoji} Quality Report

            | Metric | Value |
            |--------|-------|
            | Portfolio Score | **${typeof score === 'number' ? score.toFixed(1) : score}/100** |
            | Projects Scanned | ${report.projects_scanned || 0} |
            | Critical Issues | ${report.critical_issues || 0} |
            | High Issues | ${report.high_issues || 0} |

            ${report.degraded_projects?.length > 0 ?
              '### ⚠️ Degraded Projects\n' + report.degraded_projects.map(p =>
                `- **${p.project_name}**: ${p.previous_score?.toFixed(1)} → ${p.quality_score?.toFixed(1)}`
              ).join('\n') : ''}

            <details>
            <summary>View full report</summary>

            \`\`\`json
            ${JSON.stringify(report, null, 2).slice(0, 10000)}
            \`\`\`
            </details>`;

            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: body
            });

  security-scan:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install bandit
        run: pip install bandit

      - name: Run bandit security scan
        run: |
          bandit -r . \
            --exclude ".venv,node_modules,__pycache__,.git,dist,build,test,tests,*_test.py,conftest.py" \
            --severity-level high \
            --confidence-level high \
            -f json -o bandit-report.json || true

          # Check for critical/high issues
          if [ -f bandit-report.json ]; then
            HIGH_COUNT=$(cat bandit-report.json | python3 -c "import sys,json; d=json.load(sys.stdin); print(len([r for r in d.get('results',[]) if r.get('issue_severity')=='HIGH']))")
            if [ "$HIGH_COUNT" -gt "0" ]; then
              echo "::warning::$HIGH_COUNT high severity security issues found"
            fi
          fi

      - name: Upload security report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: security-report
          path: bandit-report.json
          retention-days: 30

  # Weekly feature generation from quality scan
  weekly-features:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    # Only run on schedule or when explicitly requested
    if: github.event_name == 'schedule' || (github.event_name == 'workflow_dispatch' && inputs.generate_features)

    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "latest"

      - name: Install harness dependencies
        run: |
          cd harness
          uv sync

      - name: Generate portfolio features
        run: |
          cd harness
          TIMESTAMP=$(date +%Y%m%d)
          OUTPUT_PATH="../features_portfolio_${TIMESTAMP}.json"

          echo "Generating portfolio features..."
          uv run forge-harness flywheel scan \
            --forge-root .. \
            --priority medium \
            --max-features 15 \
            --include-harness \
            -o "$OUTPUT_PATH"

          # Summary
          FEATURE_COUNT=$(cat "$OUTPUT_PATH" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))")
          echo "::notice::Generated $FEATURE_COUNT features"
          echo "FEATURE_COUNT=$FEATURE_COUNT" >> $GITHUB_ENV
          echo "OUTPUT_PATH=$OUTPUT_PATH" >> $GITHUB_ENV

      - name: Upload features artifact
        uses: actions/upload-artifact@v4
        with:
          name: portfolio-features-${{ github.run_number }}
          path: features_portfolio_*.json
          retention-days: 90

      - name: Create issue for feature review
        if: env.FEATURE_COUNT > 0
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const features = JSON.parse(fs.readFileSync(process.env.OUTPUT_PATH, 'utf8'));

            // Group by priority
            const byPriority = { critical: [], high: [], medium: [], low: [] };
            for (const f of features) {
              const p = f.priority || 'medium';
              if (byPriority[p]) byPriority[p].push(f);
            }

            // Build issue body
            let body = `## Weekly Portfolio Scan - ${new Date().toISOString().split('T')[0]}

            **Total Features Generated:** ${features.length}

            ### Priority Breakdown
            | Priority | Count |
            |----------|-------|
            | Critical | ${byPriority.critical.length} |
            | High | ${byPriority.high.length} |
            | Medium | ${byPriority.medium.length} |
            | Low | ${byPriority.low.length} |

            ### Top Features to Address

            `;

            // Show top 10 features
            const top = features.slice(0, 10);
            for (let i = 0; i < top.length; i++) {
              const f = top[i];
              const emoji = { critical: '🔴', high: '🟠', medium: '🟡', low: '🟢' }[f.priority] || '⚪';
              body += `${i + 1}. ${emoji} **[${f.priority}]** ${f.name}\n`;
            }

            if (features.length > 10) {
              body += `\n_...and ${features.length - 10} more features_\n`;
            }

            body += `
            ### Next Steps
            1. Review generated features in artifact
            2. Run \`forge-harness flywheel loop\` to process high-priority items
            3. Update features.json in relevant projects

            ---
            _Generated by FORGE Weekly Quality Scan_
            `;

            // Create the issue
            await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `🔍 Weekly Portfolio Scan: ${features.length} features generated`,
              body: body,
              labels: ['automation', 'tech-debt', 'quality']
            });
