name: Harness CI

on:
  push:
    branches:
      - main
    paths:
      - 'harness/forge_harness/**'
      - 'harness/tests/**'
      - 'harness/pyproject.toml'
      - 'harness/uv.lock'
      - '.github/workflows/harness-ci.yml'
  pull_request:
    branches:
      - main
    paths:
      - 'harness/forge_harness/**'
      - 'harness/tests/**'
      - 'harness/pyproject.toml'
      - 'harness/uv.lock'
      - '.github/workflows/harness-ci.yml'
  workflow_dispatch:

jobs:
  lint-and-test:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: harness

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python 3.13
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Install uv
        run: pip install uv

      - name: Cache uv dependencies
        uses: actions/cache@v4
        with:
          path: |
            ~/.cache/uv
            harness/.venv
          key: ${{ runner.os }}-uv-${{ hashFiles('harness/pyproject.toml', 'harness/uv.lock') }}
          restore-keys: |
            ${{ runner.os }}-uv-

      - name: Install dependencies
        run: uv sync

      - name: Lint with ruff
        run: uv run ruff check .

      - name: Type check with mypy
        run: uv run mypy forge_harness/ --ignore-missing-imports || true
        continue-on-error: true

      - name: Run tests
        run: uv run pytest tests/ -v --tb=short -x --timeout=120
