name: Coverage-First Policy
on:
  pull_request:
    paths:
      - 'cmd/forge/**'
  push:
    branches: [main]
    paths:
      - 'cmd/forge/**'

jobs:
  coverage-gate:
    name: Coverage Gate
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - uses: actions/setup-go@v5
        with:
          go-version: '1.21'
      
      - name: Check for Test Files
        run: |
          cd cmd/forge
          if [ $(ls *_test.go 2>/dev/null | wc -l) -lt 5 ]; then
            echo "❌ INSUFFICIENT TEST FILES"
            echo "Minimum 5 test files required"
            exit 1
          fi
          echo "✅ Sufficient test files ($(ls *_test.go | wc -l))"
      
      - name: Run Tests
        run: |
          cd cmd/forge
          go test ./... -v
      
      - name: Check Coverage by Feature
        run: |
          cd cmd/forge
          
          # Tiered coverage requirements
          # P0 features: 70%
          # P1 features: 60%
          # P2 features: 50%
          
          echo "Checking tiered coverage..."
          
          # Overall coverage must be >= 60%
          OVERALL=$(go test -cover ./... | grep "coverage:" | grep -oE "[0-9.]+%" | sed 's/%//' | head -1)
          echo "Overall coverage: ${OVERALL}%"
          
          if (( $(echo "$OVERALL < 60" | bc -l) )); then
            echo "❌ COVERAGE BELOW 60% THRESHOLD"
            exit 1
          fi
          
          echo "✅ Coverage meets 60% minimum"
      
      - name: API Contract Check
        run: |
          cd cmd/forge
          # Ensure client tests match API
          go test -v ./internal/... 2>&1 | grep -E "(PASS|FAIL)"
      
      - name: Build Verification
        run: |
          cd cmd/forge
          go build -o forge .
          echo "✅ Build successful"
      
      - name: Comment Coverage Report
        uses: actions/github-script@v7
        if: github.event_name == 'pull_request'
        with:
          script: |
            const fs = require('fs');
            const coverage = '${{ steps.check-coverage.outputs.OVERALL }}';
            
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: `## 📊 Coverage Report
              
              Overall Coverage: **${coverage}%**
              
              | Tier | Requirement | Status |
              |------|-------------|--------|
              | P0 | 70% | ${parseFloat(coverage) >= 70 ? '✅' : '⚠️'} |
              | P1 | 60% | ${parseFloat(coverage) >= 60 ? '✅' : '⚠️'} |
              | P2 | 50% | ${parseFloat(coverage) >= 50 ? '✅' : '⚠️'} |
              
              ${parseFloat(coverage) < 60 ? '❌ **MERGE BLOCKED** - Coverage below 60%' : '✅ Coverage meets requirements'}
              `
            })
