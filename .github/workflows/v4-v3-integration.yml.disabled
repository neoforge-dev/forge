name: CLI v4 ↔ v3 Daemon Integration

on:
  push:
    branches: [main]
    paths:
      - 'cmd/forge/**'
      - 'cmd/forge-v3/**'
      - '.github/workflows/v4-v3-integration.yml'
  pull_request:
    branches: [main]
    paths:
      - 'cmd/forge/**'
      - 'cmd/forge-v3/**'
      - '.github/workflows/v4-v3-integration.yml'

jobs:
  build-v3:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'

      - name: Build v3 daemon
        working-directory: cmd/forge-v3
        run: go build -o forge-v3 .

      - name: Upload v3 binary
        uses: actions/upload-artifact@v4
        with:
          name: forge-v3-binary
          path: cmd/forge-v3/forge-v3
          retention-days: 1

  integration-tests:
    runs-on: ubuntu-latest
    needs: build-v3
    services:
      # Optional: can add external services here if needed
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'

      - name: Download v3 binary
        uses: actions/download-artifact@v4
        with:
          name: forge-v3-binary
          path: cmd/forge-v3/

      - name: Make v3 binary executable
        run: chmod +x cmd/forge-v3/forge-v3

      - name: Run daemon integration tests
        working-directory: cmd/forge
        env:
          FORGE_ROOT: ${{ github.workspace }}
        run: |
          # Run only integration tests that require daemon
          go test -v -run "TestIntegration_" ./... 2>&1 | tee test-output.log

      - name: Upload test output
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: integration-test-output
          path: cmd/forge/test-output.log

  unit-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'

      - name: Run v4 CLI unit tests
        working-directory: cmd/forge
        run: go test -v ./... -run "^Test[^I]" 2>&1

  coverage:
    runs-on: ubuntu-latest
    needs: [unit-tests, integration-tests]
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'

      - name: Run tests with coverage
        working-directory: cmd/forge
        run: |
          go test -cover ./... -coverprofile=coverage.out
          go tool cover -func=coverage.out > coverage.txt
          cat coverage.txt

      - name: Check coverage threshold
        working-directory: cmd/forge
        run: |
          COVERAGE=$(go tool cover -func=coverage.out | grep total | awk '{print $3}' | tr -d '%')
          echo "Total coverage: ${COVERAGE}%"
          if (( $(echo "$COVERAGE < 60" | bc -l) )); then
            echo "❌ Coverage is below 60% threshold"
            exit 1
          fi
          echo "✅ Coverage meets threshold"

      - name: Upload coverage report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage-report
          path: |
            cmd/forge/coverage.out
            cmd/forge/coverage.txt
