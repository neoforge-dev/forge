# Interview Simulator Frontend CI/CD Pipeline
#
# ROLLBACK PROCEDURE:
# 1. Via Cloudflare Dashboard:
#    - Go to Pages > interview-simulator > Deployments
#    - Find the last working deployment
#    - Click "..." menu > "Rollback to this deployment"
#
# 2. Via Wrangler CLI:
#    wrangler pages deployment list --project-name=interview-simulator
#    wrangler pages deployment rollback <DEPLOYMENT_ID> --project-name=interview-simulator
#
# 3. Via Git revert + redeploy:
#    git revert <bad-commit-sha>
#    git push origin main
#    # This workflow will auto-deploy the reverted state
#
# IMPORTANT: This is a monorepo with 89 projects. Path filters ensure we only
# deploy when frontend files actually change.

name: Interview Simulator Frontend Deploy

on:
  push:
    branches: [main]
    paths:
      - 'codeswiftr-com/interview-simulator/frontend/**'
      - '.github/workflows/deploy-is-frontend.yml'

  # Manual trigger for on-demand deploys
  workflow_dispatch:
    inputs:
      environment:
        description: 'Deploy environment (production only for now)'
        required: false
        default: 'production'
        type: choice
        options:
          - production

env:
  NODE_VERSION: '20'
  WORKING_DIR: codeswiftr-com/interview-simulator/frontend
  PROJECT_NAME: interview-simulator

jobs:
  # Validate, build, and deploy
  deploy:
    name: Build & Deploy to Cloudflare Pages
    runs-on: ubuntu-latest

    # Prevent concurrent deployments to the same environment
    concurrency:
      group: deploy-is-frontend-${{ github.ref }}
      cancel-in-progress: false

    defaults:
      run:
        working-directory: codeswiftr-com/interview-simulator/frontend

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
          cache-dependency-path: '${{ env.WORKING_DIR }}/package-lock.json'

      - name: Validate .env.production exists
        run: |
          if [ ! -f .env.production ]; then
            echo "❌ ERROR: .env.production file not found"
            echo "Expected location: ${{ env.WORKING_DIR }}/.env.production"
            exit 1
          fi
          echo "✅ .env.production file found"

      - name: Validate VITE_API_URL in .env.production
        run: |
          if ! grep -q "VITE_API_URL" .env.production; then
            echo "❌ ERROR: VITE_API_URL not found in .env.production"
            echo "The .env.production file must contain VITE_API_URL"
            cat .env.production
            exit 1
          fi
          echo "✅ VITE_API_URL found in .env.production"
          # Show the value (masked for security)
          grep "VITE_API_URL" .env.production | sed 's/=.*/=***REDACTED***/'

      - name: Install dependencies
        run: npm ci

      - name: Lint code
        run: npm run lint
        continue-on-error: true  # Don't fail deployment on lint warnings

      - name: Type check
        run: npm run typecheck
        continue-on-error: true  # Don't fail deployment on type errors

      - name: Build application
        run: npm run build
        env:
          NODE_ENV: production

      - name: Verify build output
        run: |
          if [ ! -d "dist" ]; then
            echo "❌ ERROR: Build failed - dist directory not found"
            exit 1
          fi

          if [ ! -f "dist/index.html" ]; then
            echo "❌ ERROR: Build failed - dist/index.html not found"
            exit 1
          fi

          echo "✅ Build output verified"
          echo "Build size:"
          du -sh dist
          echo "Build contents:"
          ls -lah dist

      - name: Deploy to Cloudflare Pages
        id: deploy
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy dist --project-name=${{ env.PROJECT_NAME }} --branch=main
          workingDirectory: ${{ env.WORKING_DIR }}

      - name: Extract deployment URL
        id: deployment-url
        run: |
          # The deployment URL is typically output by wrangler
          # For production branch (main), it's usually: https://PROJECT_NAME.pages.dev
          DEPLOYMENT_URL="https://${{ env.PROJECT_NAME }}.pages.dev"
          echo "url=$DEPLOYMENT_URL" >> $GITHUB_OUTPUT
          echo "Deployment URL: $DEPLOYMENT_URL"

      - name: Wait for deployment to propagate
        run: |
          echo "Waiting 30 seconds for Cloudflare Pages deployment to propagate..."
          sleep 30

      - name: Smoke test deployment
        run: |
          DEPLOYMENT_URL="https://${{ env.PROJECT_NAME }}.pages.dev"
          echo "Running smoke test against: $DEPLOYMENT_URL"

          # Test 1: Check if site is accessible
          HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" "$DEPLOYMENT_URL")
          if [ "$HTTP_CODE" != "200" ]; then
            echo "❌ ERROR: Deployment smoke test failed"
            echo "Expected HTTP 200, got HTTP $HTTP_CODE"
            exit 1
          fi
          echo "✅ Site is accessible (HTTP $HTTP_CODE)"

          # Test 2: Check if HTML contains expected content
          RESPONSE=$(curl -s "$DEPLOYMENT_URL")
          if ! echo "$RESPONSE" | grep -q "<!DOCTYPE html>"; then
            echo "❌ ERROR: Response does not contain valid HTML"
            exit 1
          fi
          echo "✅ Valid HTML response received"

          # Test 3: Check for critical resources (optional, adjust as needed)
          if ! echo "$RESPONSE" | grep -q "script"; then
            echo "⚠️  WARNING: No script tags found in HTML (might be normal for some builds)"
          else
            echo "✅ Script tags found in HTML"
          fi

          echo "🎉 Smoke test passed! Deployment is live at: $DEPLOYMENT_URL"

      - name: Post deployment summary
        if: always()
        run: |
          echo "## Deployment Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- **Project:** Interview Simulator Frontend" >> $GITHUB_STEP_SUMMARY
          echo "- **Environment:** Production" >> $GITHUB_STEP_SUMMARY
          echo "- **URL:** https://${{ env.PROJECT_NAME }}.pages.dev" >> $GITHUB_STEP_SUMMARY
          echo "- **Commit:** ${{ github.sha }}" >> $GITHUB_STEP_SUMMARY
          echo "- **Triggered by:** ${{ github.actor }}" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY

          if [ "${{ job.status }}" == "success" ]; then
            echo "✅ **Status:** Deployment successful" >> $GITHUB_STEP_SUMMARY
          else
            echo "❌ **Status:** Deployment failed" >> $GITHUB_STEP_SUMMARY
          fi

      - name: Notify on failure
        if: failure()
        run: |
          echo "❌ Deployment failed!"
          echo "Check the logs above for details."
          echo "To rollback, see the ROLLBACK PROCEDURE at the top of this workflow file."
