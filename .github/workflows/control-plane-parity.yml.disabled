name: Control Plane Parity

on:
  push:
    branches: [main, codex/control-plane-parity]
  pull_request:
    branches: [main]
  schedule:
    # Run every 6 hours
    - cron: '0 */6 * * *'

jobs:
  parity-audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install uv
        uses: astral-sh/setup-uv@v3

      - name: Run parity audit
        env:
          FORGE_API_URL: ${{ secrets.FORGE_API_URL || 'http://localhost:8080' }}
          FORGE_WEBHOOK_TOKEN: ${{ secrets.FORGE_WEBHOOK_TOKEN }}
        run: |
          python scripts/control_plane_parity_audit.py \
            --api-url "$FORGE_API_URL" \
            --token "$FORGE_WEBHOOK_TOKEN" \
            --json > parity-audit-results.json
        continue-on-error: true

      - name: Upload parity audit results
        uses: actions/upload-artifact@v4
        with:
          name: parity-audit-results
          path: parity-audit-results.json
          retention-days: 30

      - name: Check parity audit status
        run: |
          if [ -f parity-audit-results.json ]; then
            echo "Audit results captured"
            cat parity-audit-results.json | python3 -m json.tool | head -50
          else
            echo "No audit results generated"
            exit 1
          fi

  policy-checks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install uv
        uses: astral-sh/setup-uv@v3

      - name: Run canonical docs policy check
        run: python scripts/check_canonical_docs_policy.py

      - name: Run strict lead-send docs check
        run: uv run python scripts/check_strict_lead_send_docs.py

  summary:
    needs: [parity-audit, policy-checks]
    runs-on: ubuntu-latest
    if: always()
    steps:
      - name: Summary
        run: |
          echo "## Control Plane Parity Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- Parity Audit: ${{ needs.parity-audit.result }}" >> $GITHUB_STEP_SUMMARY
          echo "- Policy Checks: ${{ needs.policy-checks.result }}" >> $GITHUB_STEP_SUMMARY
