# Voice Coach CD Pipeline
# ========================
# Deploys backend to Railway and frontend to Cloudflare Pages.
# Docker build-and-push is NOT done here — Railway builds from source
# via railway.toml (builder = "DOCKERFILE") inside the backend subdirectory.
#
# Required secrets (set in repo Settings > Secrets and variables > Actions):
#   RAILWAY_TOKEN         — Railway project token for voice-coach service
#   CLOUDFLARE_API_TOKEN  — Cloudflare API token with Pages:Edit permission
#
# Required variables (Settings > Secrets and variables > Variables):
#   CLOUDFLARE_ACCOUNT_ID — Cloudflare account ID
#   VITE_API_URL          — Production API base URL (overrides wrangler.toml default)

name: Voice Coach CD

on:
  push:
    branches: [main]
    paths:
      - 'brandfocus-ai/voice-coach/**'
      - '.github/workflows/voice-coach-cd.yml'
  workflow_dispatch:  # Allow manual trigger

jobs:
  # ===========================================================================
  # Deploy Backend to Railway
  # Railway builds the Docker image itself using railway.toml + backend/Dockerfile.
  # The CLI is invoked from the backend subdirectory so Railway picks up the
  # correct railway.toml (builder = "DOCKERFILE", healthcheckPath = /api/health).
  # ===========================================================================
  deploy-backend:
    name: Deploy Backend to Railway
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    environment: production
    defaults:
      run:
        working-directory: brandfocus-ai/voice-coach/app/backend

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Install Railway CLI
        run: npm install -g @railway/cli

      - name: Deploy to Railway
        env:
          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}
        run: railway up --detach

      - name: Add to deployment summary
        run: |
          echo "## Railway Backend Deployment" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- **Status:** Deployed to Railway" >> $GITHUB_STEP_SUMMARY
          echo "- **Service:** voice-coach-backend" >> $GITHUB_STEP_SUMMARY
          echo "- **Health check:** /api/health (30s timeout)" >> $GITHUB_STEP_SUMMARY
          echo "- **Commit:** \`${{ github.sha }}\`" >> $GITHUB_STEP_SUMMARY

  # ===========================================================================
  # Deploy Frontend to Cloudflare Pages
  # Builds the Vite app and deploys to the "voice-coach-app" Pages project.
  # VITE_API_URL is injected at build time from a repository variable so the
  # hardcoded wrangler.toml default can be overridden without a file edit.
  # ===========================================================================
  deploy-frontend:
    name: Deploy Frontend to Cloudflare Pages
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    environment: production
    defaults:
      run:
        working-directory: brandfocus-ai/voice-coach/app/frontend

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: brandfocus-ai/voice-coach/app/frontend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Build frontend
        env:
          VITE_API_URL: ${{ vars.VITE_API_URL }}
        run: npm run build

      - name: Deploy to Cloudflare Pages
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy brandfocus-ai/voice-coach/app/frontend/dist --project-name=voice-coach-app

      - name: Add to deployment summary
        run: |
          echo "## Cloudflare Pages Deployment" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- **Status:** Deployed to Cloudflare Pages" >> $GITHUB_STEP_SUMMARY
          echo "- **Project:** voice-coach-app" >> $GITHUB_STEP_SUMMARY
          echo "- **Commit:** \`${{ github.sha }}\`" >> $GITHUB_STEP_SUMMARY

  # ===========================================================================
  # Post-deploy health check
  # Polls /api/health after Railway's async deploy finishes.
  # Runs after both deploy jobs and fails the pipeline if the API is down.
  # ===========================================================================
  health-check:
    name: Health Check
    runs-on: ubuntu-latest
    needs: [deploy-backend]
    if: always() && needs.deploy-backend.result == 'success'
    environment: production

    steps:
      - name: Wait for Railway deployment to become healthy
        env:
          HEALTH_URL: "https://voice-coach-api-production.up.railway.app/api/health"
        run: |
          echo "Polling $HEALTH_URL (up to 3 minutes)..."
          for i in $(seq 1 18); do
            STATUS=$(curl -s -o /dev/null -w "%{http_code}" "$HEALTH_URL" || echo "000")
            echo "Attempt $i/18 — HTTP $STATUS"
            if [ "$STATUS" = "200" ]; then
              echo "Health check passed."
              exit 0
            fi
            sleep 10
          done
          echo "Health check failed — service did not become healthy within 3 minutes."
          exit 1

      - name: Add to deployment summary
        if: always()
        run: |
          echo "## Health Check" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- **Endpoint:** https://voice-coach-api-production.up.railway.app/api/health" >> $GITHUB_STEP_SUMMARY
          echo "- **Result:** ${{ job.status }}" >> $GITHUB_STEP_SUMMARY

  # ===========================================================================
  # Deployment Notification
  # ===========================================================================
  notify:
    name: Notify
    runs-on: ubuntu-latest
    needs: [deploy-backend, deploy-frontend, health-check]
    if: always()

    steps:
      - name: Create deployment summary
        run: |
          echo "## Voice Coach Deployment Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "| Job | Result |" >> $GITHUB_STEP_SUMMARY
          echo "|-----|--------|" >> $GITHUB_STEP_SUMMARY
          echo "| Backend (Railway) | ${{ needs.deploy-backend.result }} |" >> $GITHUB_STEP_SUMMARY
          echo "| Frontend (Cloudflare Pages) | ${{ needs.deploy-frontend.result }} |" >> $GITHUB_STEP_SUMMARY
          echo "| Health Check | ${{ needs.health-check.result }} |" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- **Commit:** \`${{ github.sha }}\`" >> $GITHUB_STEP_SUMMARY
          echo "- **Branch:** \`${{ github.ref_name }}\`" >> $GITHUB_STEP_SUMMARY
          echo "- **Triggered by:** ${{ github.actor }}" >> $GITHUB_STEP_SUMMARY
