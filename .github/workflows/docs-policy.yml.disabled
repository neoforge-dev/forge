name: Docs Policy

on:
  push:
    branches:
      - main
    paths:
      - 'AGENTS.md'
      - 'docs/PROMPT.md'
      - 'docs/FORGE_CLI_V2_REFERENCE.md'
      - 'docs/COMMON_WORKFLOWS.md'
      - 'docs/GETTING_STARTED.md'
      - 'docs/QUICK_START.md'
      - 'docs/onboarding/WORKFLOWS.md'
      - 'docs/openclaw/AGENTS.md'
      - 'docs/runbooks/**'
      - 'harness/docs/AUTONOMOUS_WORKFLOW.md'
      - '.claude/modules/continuous-loop.md'
      - '.claude/skills/dispatch/SKILL.md'
      - '.claude/skills/spawn-agent/SKILL.md'
      - '.claude/skills/mvp-bootstrap-orchestrator/SKILL.md'
      - '.claude/skills/mvp-spec-writer/SKILL.md'
      - '.claude/skills/niche-explorer/SKILL.md'
      - '.claude/skills/heartbeat/SKILL.md'
      - 'scripts/check_strict_lead_send_docs.py'
      - 'scripts/check_canonical_docs_policy.py'
      - '.github/workflows/docs-policy.yml'
  pull_request:
    branches:
      - main
    paths:
      - 'AGENTS.md'
      - 'docs/PROMPT.md'
      - 'docs/FORGE_CLI_V2_REFERENCE.md'
      - 'docs/COMMON_WORKFLOWS.md'
      - 'docs/GETTING_STARTED.md'
      - 'docs/QUICK_START.md'
      - 'docs/onboarding/WORKFLOWS.md'
      - 'docs/openclaw/AGENTS.md'
      - 'docs/runbooks/**'
      - 'harness/docs/AUTONOMOUS_WORKFLOW.md'
      - '.claude/modules/continuous-loop.md'
      - '.claude/skills/dispatch/SKILL.md'
      - '.claude/skills/spawn-agent/SKILL.md'
      - '.claude/skills/mvp-bootstrap-orchestrator/SKILL.md'
      - '.claude/skills/mvp-spec-writer/SKILL.md'
      - '.claude/skills/niche-explorer/SKILL.md'
      - '.claude/skills/heartbeat/SKILL.md'
      - 'scripts/check_strict_lead_send_docs.py'
      - 'scripts/check_canonical_docs_policy.py'
      - '.github/workflows/docs-policy.yml'

jobs:
  docs-policy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Check strict lead-send examples
        run: python scripts/check_strict_lead_send_docs.py
      - name: Check canonical docs command policy
        run: python scripts/check_canonical_docs_policy.py
