name: V4 CLI Tests
on: 
  push:
    branches: [main]
    paths:
      - 'cmd/forge/**'
      - '.forge/**'
      - '.github/workflows/v4-cli-tests.yml'
  pull_request:
    branches: [main]
    paths:
      - 'cmd/forge/**'
      - '.forge/**'
      - '.github/workflows/v4-cli-tests.yml'

jobs:
  test:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: cmd/forge
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'
          cache: true
          cache-dependency-path: cmd/forge/go.sum

      - name: Download dependencies
        run: go mod download

      - name: Run tests
        run: go test -v ./...

      - name: Run tests with coverage
        run: go test -cover ./... -coverprofile=coverage.out

      - name: Generate coverage report
        run: |
          go tool cover -func=coverage.out > coverage.txt
          cat coverage.txt

      - name: Check coverage threshold
        run: |
          COVERAGE=$(go tool cover -func=coverage.out | grep total | awk '{print $3}' | tr -d '%')
          echo "Total coverage: ${COVERAGE}%"
          if (( $(echo "$COVERAGE < 60" | bc -l) )); then
            echo "Coverage is below 60% threshold"
            exit 1
          fi
          echo "✓ Coverage meets threshold"

      - name: Upload coverage report
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: coverage-report
          path: |
            cmd/forge/coverage.out
            cmd/forge/coverage.txt

  integration:
    runs-on: ubuntu-latest
    needs: test
    defaults:
      run:
        working-directory: cmd/forge
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'

      - name: Run integration tests
        run: go test -v -run "TestIntegration|TestDomainCommands|TestApprovalCommands|TestProjectCommands|TestConfigCommands|TestPatternCommands|TestDispatchWorkflow|TestShipWorkflow" ./...

      - name: Test output formats
        run: go test -v -run "TestOutputFormats" ./...

      - name: Test error handling
        run: go test -v -run "TestErrorHandling" ./...
