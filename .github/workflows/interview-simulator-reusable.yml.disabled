name: Interview Simulator CI (Reusable)

on:
  push:
    branches: [main]
    paths:
      - 'codeswiftr-com/interview-simulator/**'
      - '.github/workflows/interview-simulator-reusable.yml'
      - '.github/workflows/reusable-backend-ci.yml'
      - '.github/workflows/reusable-frontend-ci.yml'
  pull_request:
    paths:
      - 'codeswiftr-com/interview-simulator/**'
      - '.github/workflows/interview-simulator-reusable.yml'

jobs:
  backend-ci:
    name: Backend CI
    uses: ./.github/workflows/reusable-backend-ci.yml
    with:
      project_path: 'codeswiftr-com/interview-simulator/backend'
      python_version: '3.12'
      coverage_threshold: 75
      enable_mypy: true
      enable_docker_build: false  # Deploying to Railway (no Dockerfile needed)

  frontend-ci:
    name: Frontend CI
    uses: ./.github/workflows/reusable-frontend-ci.yml
    with:
      project_path: 'codeswiftr-com/interview-simulator/frontend'
      node_version: '20'
      enable_tests: true
      build_env_vars: '{"VITE_API_URL": "https://api.example.com"}'

  # Optional: Add deployment jobs after CI passes
  deploy-backend:
    name: Deploy Backend to Railway
    runs-on: ubuntu-latest
    needs: [backend-ci]
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'

    steps:
      - uses: actions/checkout@v4

      - name: Install Railway CLI
        run: npm install -g @railway/cli

      - name: Deploy to Railway
        run: |
          cd codeswiftr-com/interview-simulator/backend
          railway up --service interview-simulator-api
        env:
          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}

  deploy-frontend:
    name: Deploy Frontend to Cloudflare
    runs-on: ubuntu-latest
    needs: [frontend-ci]
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: 'codeswiftr-com/interview-simulator/frontend/package-lock.json'

      - name: Install dependencies
        working-directory: codeswiftr-com/interview-simulator/frontend
        run: npm ci

      - name: Build
        working-directory: codeswiftr-com/interview-simulator/frontend
        run: npm run build
        env:
          VITE_API_URL: ${{ secrets.INTERVIEW_API_URL }}

      - name: Deploy to Cloudflare Pages
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy dist --project-name=interview-simulator-app --branch=main
          workingDirectory: codeswiftr-com/interview-simulator/frontend
