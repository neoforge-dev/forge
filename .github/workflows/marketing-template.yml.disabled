name: Marketing Template CI/CD

on:
  push:
    branches: [main]
    paths:
      - 'marketing-template/**'
      - 'docs/blog/**'
      - '.github/workflows/marketing-template.yml'
  pull_request:
    paths:
      - 'marketing-template/**'
      - '.github/workflows/marketing-template.yml'
  workflow_dispatch:
    inputs:
      domain:
        description: 'Domain to deploy (or "all")'
        required: true
        default: 'all'
        type: choice
        options:
          - all
          - codeswiftr
          - thebrightharbor
          - neoforge
          - brandfocus
          - adguild
          - calmconnect
          - leanvibe
          - leanvibedev
          - mumchef
          - babybit

jobs:
  test-build:
    name: Test & Build
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: marketing-template

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'
          cache-dependency-path: 'marketing-template/package-lock.json'

      - name: Install dependencies
        run: npm ci

      - name: Lint
        run: npm run lint || true

      - name: Run tests
        run: npm run test -- --run

      - name: Build (test with codeswiftr)
        run: npm run build
        env:
          VITE_LANDING_DOMAIN: codeswiftr
          VITE_API_BASE: https://marketing-api-production.up.railway.app

  # Deploy all domains to Cloudflare Pages
  deploy:
    name: Deploy to Cloudflare
    runs-on: ubuntu-latest
    needs: [test-build]
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    strategy:
      matrix:
        include:
          - domain: codeswiftr
            project: codeswiftr
          - domain: thebrightharbor
            project: thebrightharbor
          # Add more domains as they're ready
          # - domain: neoforge
          #   project: neoforge
          # - domain: brandfocus
          #   project: brandfocus

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'
          cache-dependency-path: 'marketing-template/package-lock.json'

      - name: Install dependencies
        working-directory: marketing-template
        run: npm ci

      - name: Build for ${{ matrix.domain }}
        working-directory: marketing-template
        run: npm run build
        env:
          VITE_LANDING_DOMAIN: ${{ matrix.domain }}
          VITE_API_BASE: ${{ secrets.MARKETING_API_URL }}

      - name: Deploy ${{ matrix.domain }} to Cloudflare
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy dist --project-name=${{ matrix.project }} --branch=main
          workingDirectory: marketing-template

  # Manual deployment for specific domain
  deploy-single:
    name: Deploy Single Domain
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch'

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'
          cache-dependency-path: 'marketing-template/package-lock.json'

      - name: Install dependencies
        working-directory: marketing-template
        run: npm ci

      - name: Build for ${{ inputs.domain }}
        working-directory: marketing-template
        run: npm run build
        env:
          VITE_LANDING_DOMAIN: ${{ inputs.domain }}
          VITE_API_BASE: ${{ secrets.MARKETING_API_URL }}

      - name: Deploy to Cloudflare
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy dist --project-name=${{ inputs.domain }} --branch=main
          workingDirectory: marketing-template
