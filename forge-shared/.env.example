# Application Configuration
APP_NAME="forge-app"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security
SECRET_KEY="change-me-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=30

# Database
DATABASE_URL="postgresql://localhost/forge"
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL="redis://localhost:6379"

# Analytics (PostHog)
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
